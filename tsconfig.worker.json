{
  // Type checking for the Cloudflare Worker entry and its modules only.
  //
  // The root tsconfig includes every file in the repo, which pulls in both the
  // events Astro pages (they need astro:content types generated by a build) and
  // the nested learn/ package (its own copies of astro and vite produce
  // duplicate-identity errors). Neither is a real defect, and neither is worth
  // type checking from here, so this config covers the Worker surface alone.
  //
  // Run with: npx tsc --noEmit -p tsconfig.worker.json
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "src/worker.ts",
    "src/fde-gym/**/*.ts",
    "src/fde-gym/**/*.json",
    "src/coach/**/*.ts"
  ]
}
