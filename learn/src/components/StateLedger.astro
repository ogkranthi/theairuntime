---
import { LEDGER_LABELS, MODULE_SLUGS, pad } from "../lib/course";

interface Props {
  /** Module number carrying the arrow marker. Home page passes 0. */
  current?: number;
  /** Value of the STATUS row. */
  status?: string;
  /** Mark every module before `current` as done. Module pages do, home does not. */
  progress?: boolean;
  /** Link each row to its module page. */
  linked?: boolean;
}

const { current = 0, status = "ready", progress = false, linked = true } = Astro.props;

function esc(s: string): string {
  return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
}

const numbers = Object.keys(LEDGER_LABELS)
  .map(Number)
  .sort((a, b) => a - b);

// Built as markup rather than as JSX so the whitespace inside <pre> stays exact.
// The ledger is a monospace block; a stray newline from a template would show.
const rows = numbers
  .map((n) => {
    const state = n === current ? "current" : progress && n < current ? "done" : "todo";
    const marker = state === "current" ? "&rarr;" : state === "done" ? "&check;" : "&cir;";
    const label = esc(LEDGER_LABELS[n] as string);
    const body = linked ? `<a href="/course-001/${MODULE_SLUGS[n]}/">${label}</a>` : label;
    return `<span class="ledger__row ledger__row--${state}">${marker} ${pad(n)} ${body}</span>`;
  })
  .join("\n");

const html = [
  `<span class="ledger__key">RUN</span>     <span class="ledger__head">course-001</span>`,
  `<span class="ledger__key">STATUS</span>  <span class="ledger__head">${esc(status)}</span>`,
  rows,
].join("\n");
---

<pre class="ledger" aria-label="Course state ledger" set:html={html} />
