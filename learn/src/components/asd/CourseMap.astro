---
import { formatMinutes, groupByTrack, moduleHref, type AsdModule } from "../../lib/asd";

interface Props {
  modules: AsdModule[];
  /** Slug of the module currently being read, if any. */
  current?: string;
  /** Compact rail variant used inside a lesson. */
  compact?: boolean;
}

const { modules, current, compact = false } = Astro.props;
const groups = groupByTrack(modules);
---

<nav class:list={["cmap", { "cmap--compact": compact }]} aria-label="Course modules" data-course-map>
  {
    groups.map((group) => (
      <section class="cmap__track">
        <h3 class="cmap__trackname">
          {group.track}
          <span class="cmap__tracktime">
            {formatMinutes(group.modules.reduce((sum, m) => sum + m.data.duration_minutes, 0))}
          </span>
        </h3>
        <ol class="cmap__list">
          {group.modules.map((m) => (
            <li>
              <a
                href={moduleHref(m)}
                data-module={m.data.slug}
                class:list={{ "is-current": m.data.slug === current }}
                aria-current={m.data.slug === current ? "page" : undefined}
              >
                <span class="cmap__num" aria-hidden="true">{m.data.id}</span>
                <span class="cmap__body">
                  <span class="cmap__title">{m.data.title}</span>
                  {!compact && <span class="cmap__build">{m.data.build_milestone}</span>}
                </span>
                <span class="cmap__meta">
                  {!compact && <span class="cmap__diff" data-difficulty={m.data.difficulty}>{m.data.difficulty}</span>}
                  <span class="cmap__mins">{m.data.duration_minutes}m</span>
                </span>
                <span class="cmap__tick" data-tick aria-hidden="true" />
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</nav>

<script>
  import { read } from "../../scripts/asd-progress";

  const done = new Set(read().completedModules);
  document.querySelectorAll<HTMLElement>("[data-course-map] [data-module]").forEach((link) => {
    if (done.has(link.dataset.module ?? "")) {
      link.dataset.done = "true";
      const tick = link.querySelector<HTMLElement>("[data-tick]");
      if (tick) tick.textContent = "✓";
    }
  });
</script>

<style>
  .cmap__track { margin-bottom: 1.75rem; }
  .cmap__track:last-child { margin-bottom: 0; }
  .cmap__trackname {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin: 0 0 0.6rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--line);
  }
  .cmap__tracktime { color: var(--fg-muted); opacity: 0.8; letter-spacing: 0.04em; }
  .cmap__list { list-style: none; margin: 0; padding: 0; }
  .cmap__list li { margin: 0; }
  .cmap__list a {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto 1.1rem;
    align-items: baseline;
    gap: 0.65rem;
    padding: 0.6rem 0.6rem;
    margin: 0 -0.6rem;
    border-radius: var(--radius-sm);
    color: var(--fg);
  }
  .cmap__list a:hover { background: var(--bg-inset); text-decoration: none; }
  .cmap__list a.is-current { background: var(--bg-inset); }
  .cmap__list a.is-current .cmap__title { color: var(--accent); }
  .cmap__num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-muted);
  }
  .cmap__list a.is-current .cmap__num { color: var(--accent); }
  .cmap__body { min-width: 0; }
  .cmap__title { display: block; font-weight: 600; font-size: 0.95rem; line-height: 1.35; }
  .cmap__build {
    display: block;
    font-size: 0.78rem;
    color: var(--fg-muted);
    margin-top: 0.15rem;
  }
  .cmap__meta {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--fg-muted);
    white-space: nowrap;
  }
  .cmap__diff {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.05rem 0.5rem;
    letter-spacing: 0.06em;
  }
  .cmap__diff[data-difficulty="Advanced"] { border-color: var(--accent-dim); color: var(--accent); }
  .cmap__diff[data-difficulty="Capstone"] { background: var(--accent); border-color: var(--accent); color: #fff; }
  .cmap__tick {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: #15803D;
    text-align: right;
  }

  .cmap--compact .cmap__list a {
    grid-template-columns: 1.8rem minmax(0, 1fr) auto 1rem;
    padding: 0.35rem 0.5rem;
    margin: 0 -0.5rem;
    gap: 0.5rem;
  }
  .cmap--compact .cmap__title { font-size: 0.83rem; font-weight: 500; }
  .cmap--compact a.is-current .cmap__title { font-weight: 650; }
  .cmap--compact .cmap__track { margin-bottom: 1.1rem; }

  @media (max-width: 620px) {
    /* Stack the duration/difficulty under the title so nothing has to shrink. */
    .cmap__list a { grid-template-columns: 1.8rem minmax(0, 1fr) 1rem; }
    .cmap__meta { grid-column: 2 / 3; grid-row: 2; margin-top: 0.3rem; }
    .cmap__tick { grid-column: 3; grid-row: 1; }
  }
</style>
