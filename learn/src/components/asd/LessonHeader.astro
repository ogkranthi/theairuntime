---
import { ASD_BASE, formatMinutes, type AsdModule } from "../../lib/asd";

interface Props {
  module: AsdModule;
  /** Modules that must come first, resolved to title + href. */
  prerequisites: { slug: string; title: string }[];
  position: { index: number; total: number };
}

const { module, prerequisites, position } = Astro.props;
const d = module.data;
---

<header class="lhead">
  <p class="lhead__crumb">
    <a href={`${ASD_BASE}/`}>Agentic AI System Design</a>
    <span aria-hidden="true">/</span>
    <span>{d.track}</span>
  </p>

  <p class="lhead__eyebrow">
    <span class="lhead__num">MODULE {d.id}</span>
    <span class="lhead__of">{position.index} of {position.total}</span>
  </p>

  <h1 class="lhead__title">{d.title}</h1>

  <p class="lhead__build">
    <span class="lhead__buildkey">YOU WILL BUILD</span>
    {d.build_milestone}
  </p>

  <dl class="lhead__facts">
    <div>
      <dt>Time</dt>
      <dd>{formatMinutes(d.duration_minutes)}</dd>
    </div>
    <div>
      <dt>Level</dt>
      <dd>{d.difficulty}</dd>
    </div>
    <div>
      <dt>Track</dt>
      <dd>{d.track}</dd>
    </div>
    {
      prerequisites.length > 0 && (
        <div class="lhead__facts-wide">
          <dt>Do first</dt>
          <dd>
            {prerequisites.map((p, i) => <><a href={`${ASD_BASE}/modules/${p.slug}/`}>{p.title}</a>{i < prerequisites.length - 1 ? ", " : ""}</>)}
          </dd>
        </div>
      )
    }
  </dl>

  <section class="lhead__objectives" aria-labelledby={`obj-${d.slug}`}>
    <h2 class="lhead__objkey" id={`obj-${d.slug}`}>By the end you can</h2>
    <ul>
      {d.objectives.map((o) => <li>{o}</li>)}
    </ul>
  </section>
</header>

<style>
  .lhead { margin-bottom: 2.75rem; }
  .lhead__crumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--fg-muted);
    margin: 0 0 1.25rem;
  }
  .lhead__crumb a { color: var(--fg-muted); }
  .lhead__crumb a:hover { color: var(--accent); }

  .lhead__eyebrow {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    margin: 0 0 0.7rem;
  }
  .lhead__num { color: var(--accent); }
  .lhead__of { color: var(--fg-muted); letter-spacing: 0.04em; }

  .lhead__title {
    font-size: clamp(1.85rem, 4.2vw, 2.6rem);
    letter-spacing: -0.03em;
    max-width: 20ch;
    margin: 0 0 1.1rem;
  }

  .lhead__build {
    font-size: 1.05rem;
    color: var(--fg);
    border-left: 2px solid var(--accent);
    padding-left: 1rem;
    margin: 0 0 1.5rem;
    max-width: 56ch;
  }
  .lhead__buildkey {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--accent);
    margin-bottom: 0.3rem;
  }

  .lhead__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
    gap: 0.9rem 1.5rem;
    margin: 0 0 1.75rem;
    padding: 1rem 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .lhead__facts-wide { grid-column: 1 / -1; }
  .lhead__facts dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin-bottom: 0.25rem;
  }
  .lhead__facts dd { margin: 0; font-size: 0.9rem; }

  .lhead__objectives {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raise);
    padding: 1.15rem 1.4rem;
  }
  .lhead__objkey {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin: 0 0 0.7rem;
  }
  .lhead__objectives ul { margin: 0; padding-left: 1.1rem; }
  .lhead__objectives li { margin: 0 0 0.4rem; font-size: 0.95rem; }
  .lhead__objectives li:last-child { margin-bottom: 0; }
</style>
