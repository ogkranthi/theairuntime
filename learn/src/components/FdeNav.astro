---
const path = Astro.url.pathname;
const links = [{href:"/career/segments/",label:"Segments"},{href:"/career/roles/",label:"Roles"},{href:"/career/progression/",label:"Progression"},{href:"/career/companies/",label:"Companies"},{href:"/career/interviews/",label:"Interviews"},{href:"/career/compensation/",label:"Compensation"},{href:"/career/jobs/",label:"Jobs"}];
---
<nav class="fde-nav" aria-label="FDE Career"><div class="shell"><a class="brand" href="/career/">CAREER</a>{links.map(l=><a class:list={{active:path===l.href||path.startsWith(l.href)}} href={l.href}>{l.label}</a>)}</div></nav>
<style>.fde-nav{border-bottom:1px solid var(--line);background:#fff}.fde-nav .shell{display:flex;gap:1.25rem;align-items:center;min-height:3rem;overflow-x:auto;font:500 .7rem var(--font-mono);white-space:nowrap}.fde-nav a{color:var(--fg-muted)}.fde-nav a:hover{text-decoration:none;color:var(--fg)}.fde-nav .brand{color:var(--accent);letter-spacing:.1em;margin-right:auto}.fde-nav .active{color:var(--fg);border-bottom:2px solid var(--accent);padding-block:.85rem}</style>
