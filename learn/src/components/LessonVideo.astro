---
/**
 * Responsive YouTube embed, lazy-loaded (click-to-load facade keeps the page
 * free of third-party JS until the learner asks for it). When no URL is set,
 * renders a quiet "Video coming soon" line, never a disabled control.
 */
interface Props {
  url?: string;
  title: string;
}
const { url, title } = Astro.props;

function embedUrl(u: string): string | undefined {
  try {
    const parsed = new URL(u);
    let id = "";
    if (parsed.hostname.includes("youtu.be")) id = parsed.pathname.slice(1);
    else if (parsed.pathname.startsWith("/watch")) id = parsed.searchParams.get("v") ?? "";
    else if (parsed.pathname.startsWith("/embed/")) id = parsed.pathname.split("/")[2] ?? "";
    return id ? `https://www.youtube-nocookie.com/embed/${id}?autoplay=1` : undefined;
  } catch {
    return undefined;
  }
}
const embed = url ? embedUrl(url) : undefined;
---

{
  embed ? (
    <div class="video" data-embed={embed}>
      <button type="button" class="video__facade" aria-label={`Play video: ${title}`}>
        <span class="video__play" aria-hidden="true">&#9654;</span>
        <span class="video__label">Watch: {title}</span>
      </button>
    </div>
  ) : (
    <p class="video-soon">Video coming soon. The written lesson below is complete on its own.</p>
  )
}

<style>
  .video {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--code-bg);
    border: 1px solid var(--code-line);
    margin: 1.5rem 0;
  }
  .video__facade {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    background: transparent;
    border: 0;
    cursor: pointer;
    color: #e6e6e9;
    font-family: var(--font-body);
    font-size: var(--t-body);
  }
  .video__play {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    padding-left: 0.2rem;
  }
  .video__facade:hover .video__play { background: #EA580C; }
  .video__label { font-size: var(--t-meta); }
  .video :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video-soon {
    font-family: var(--font-mono);
    font-size: var(--t-meta);
    color: var(--fg-muted);
    margin: 1rem 0 1.5rem;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".video").forEach((wrap) => {
    const btn = wrap.querySelector("button");
    btn?.addEventListener("click", () => {
      const iframe = document.createElement("iframe");
      iframe.src = wrap.dataset.embed ?? "";
      iframe.title = btn.getAttribute("aria-label") ?? "Lesson video";
      iframe.allow = "accelerometer; autoplay; encrypted-media; picture-in-picture";
      iframe.allowFullscreen = true;
      wrap.replaceChildren(iframe);
    });
  });
</script>
