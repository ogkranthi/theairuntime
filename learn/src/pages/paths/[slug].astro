---
import Base from "../../layouts/Base.astro"; import { paths } from "../../data/paths"; import type {FdePath} from "../../lib/fde/types";
export async function getStaticPaths(){
  return paths.map((path) => ({ params: { slug: path.slug }, props: { path } }));
}
const { path } = Astro.props as { path:FdePath };
---
<Base title={`${path.title} | FDE Commons`} description={path.description} pageSlug={path.slug}><div class="shell path"><header><p class="eyebrow">ENTRY JOURNEY</p><h1>{path.title}</h1><p>{path.description}</p><div><span>CURRENT POSITION</span><strong>{path.audience}</strong><span>DESTINATION</span><strong>{path.goal}</strong></div></header><main><p class="eyebrow">MILESTONES</p>{path.milestones.map((m,i)=><section><span>0{i+1}</span><div><small>DESIRED OUTCOME</small><h2>{m.title}</h2><p>{m.outcome}</p><b>CANONICAL ASSETS</b><ul>{m.assetSlugs.map(a=><li>{a.replaceAll("-"," ")}</li>)}</ul></div><aside><small>PROOF</small><strong>{m.proof}</strong></aside></section>)}</main><footer><p>Your next move should create evidence.</p><a class="btn btn--solid" href="/practice/field-report/">Open the Field Report template →</a></footer></div></Base>
<style>.path{max-width:1000px}.path header{padding:7rem 0}.path h1{font-size:clamp(3.5rem,7vw,7rem);max-width:13ch}.path header>p:nth-child(3){color:var(--fg-muted);font-size:1.15rem}.path header>div{display:grid;grid-template-columns:auto 1fr;gap:.3rem 1rem;background:#fff1e6;padding:1rem;margin-top:2rem}.path header span,section small,section>b{font:500 .62rem var(--font-mono);color:var(--accent)}main>section{display:grid;grid-template-columns:4rem 1fr 13rem;gap:2rem;padding:2rem 0;border-top:1px solid var(--line)}section>span{font:500 2rem var(--font-mono);color:var(--accent-dim)}section p{color:var(--fg-muted)}section aside{border-left:2px solid var(--accent);padding-left:1rem}section aside strong{display:block}.path footer{background:#18181b;color:white;margin:4rem calc(50% - 50vw) 0;padding:4rem max(var(--pad),calc((100vw - 1000px)/2 + var(--pad)))}@media(max-width:650px){main>section{grid-template-columns:2rem 1fr}section aside{grid-column:2}}</style>
