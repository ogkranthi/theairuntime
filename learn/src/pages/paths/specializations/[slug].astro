---
import Base from "../../../layouts/Base.astro"; import {specializations} from "../../../data/paths";
export async function getStaticPaths(){
  return specializations.map((specialization) => ({ params: { slug: specialization.slug }, props: { specialization } }));
}
const { specialization } = Astro.props as { specialization:(typeof specializations)[number] };
---
<Base title={`${specialization.title} Path | FDE Commons`} description={specialization.summary} pageSlug={`path-${specialization.slug}`}><div class="shell spec"><header><p class="eyebrow">TECHNICAL SPECIALIZATION</p><h1>{specialization.title}</h1><div><span>WHAT YOU FORWARD DEPLOY</span><strong>{specialization.deploys}</strong></div><p>{specialization.summary}</p></header><section><p class="eyebrow">CAPABILITY MAP</p><h2>Build depth across the actual boundary.</h2><div>{specialization.focus.map((f,i)=><article><span>{String(i+1).padStart(2,"0")}</span><h3>{f}</h3></article>)}</div></section><section class="start"><h2>Start with shared production foundations.</h2><p>Specializations change the technical center, not the need for discovery, reliability, evidence, tradeoffs, and customer outcome ownership.</p><a class="btn btn--solid" href="/learn/">Browse canonical learning →</a></section></div></Base>
<style>.spec{max-width:1050px}.spec header{padding:7rem 0}.spec h1{font-size:clamp(3.5rem,7vw,7rem);max-width:12ch}.spec header>div{border-left:4px solid var(--accent);background:#fff1e6;padding:1rem;max-width:45rem}.spec header span{display:block;font:500 .62rem var(--font-mono);color:var(--accent)}.spec header>p:last-child{color:var(--fg-muted);font-size:1.15rem;max-width:55ch;margin-top:2rem}.spec section{padding:5rem 0;border-top:1px solid var(--line)}.spec section>div{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line)}article{padding:1rem;border:1px solid var(--line)}article span{font:500 .62rem var(--font-mono);color:var(--accent)}.start{background:#18181b;color:white;margin-inline:calc(50% - 50vw);padding-inline:max(var(--pad),calc((100vw - 1050px)/2 + var(--pad)))!important}.start h2{color:white}.start p{color:#b7b7be;max-width:60ch}@media(max-width:600px){.spec section>div{grid-template-columns:1fr 1fr}}</style>
