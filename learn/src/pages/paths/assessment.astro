---
import Base from "../../layouts/Base.astro";
const questions=[
 {id:"role",prompt:"Where are you starting?",options:[{label:"Software / AI engineer",journey:"software",agent:2,platform:1,inference:1},{label:"Solutions / architecture",journey:"solutions",agent:1,platform:2},{label:"Working FDE",journey:"senior",agent:1,platform:1,inference:1}]},
 {id:"artifact",prompt:"What do you most want to own?",options:[{label:"A production AI workflow",agent:3},{label:"A data-backed enterprise application",platform:3},{label:"A fast, reliable model endpoint",inference:3}]},
 {id:"customer",prompt:"How close do you want to work with users?",options:[{label:"Embedded in their workflow",agent:2,platform:1},{label:"With technical platform teams",platform:2,inference:2},{label:"Mostly behind the product boundary",inference:2}]},
 {id:"problem",prompt:"Which debugging problem sounds best?",options:[{label:"Model + context + tools + UX",agent:3},{label:"Data + identity + integrations",platform:3},{label:"Latency + throughput + scaling",inference:3}]},
 {id:"strength",prompt:"What is your strongest base today?",options:[{label:"Full-stack / backend code",agent:2},{label:"Architecture / APIs / cloud",platform:2},{label:"ML systems / infrastructure",inference:3}]},
 {id:"gap",prompt:"What do you most need to build?",options:[{label:"Discovery and customer ownership",gap:"customer discovery"},{label:"Durable production AI systems",gap:"durable workflow engineering"},{label:"Evaluation and evidence",gap:"evals and evidence"}]},
 {id:"pace",prompt:"What kind of work rhythm fits you?",options:[{label:"Rapid workflow iteration with users",agent:2},{label:"Longer enterprise integration arcs",platform:2},{label:"Deep performance investigation",inference:2}]},
 {id:"proof",prompt:"What proof would you enjoy producing?",options:[{label:"A failure-tested agent",agent:2},{label:"A governed integration architecture",platform:2},{label:"A serving benchmark",inference:2}]},
 {id:"environment",prompt:"Which environment interests you?",options:[{label:"Business operations",agent:2},{label:"Enterprise cloud and data",platform:2},{label:"GPU and compute infrastructure",inference:3}]},
 {id:"goal",prompt:"What is the immediate goal?",options:[{label:"Move into my first FDE role",goal:"entry"},{label:"Choose an FDE specialization",goal:"specialize"},{label:"Grow into senior scope",journey:"senior"}]}
];
---
<Base title="Where do I fit? | FDE Path Assessment" description="A deterministic, explainable assessment that recommends an FDE specialization, journey, gaps, proof, and interview priorities." pageSlug="fde-assessment"><div class="shell assess"><header><p class="eyebrow">WHERE DO I FIT?</p><h1>Find your FDE path.</h1><p>Ten questions. Transparent scoring. No account, no AI judgment, and no fake precision.</p></header><form data-assessment>{questions.map((q,i)=><fieldset data-question><legend><span>{String(i+1).padStart(2,"0")}</span>{q.prompt}</legend><div>{q.options.map((o)=><label><input type="radio" name={q.id} value={JSON.stringify(o)} required/><span>{o.label}</span></label>)}</div></fieldset>)}<button class="btn btn--solid" type="submit">Show my path →</button></form><section class="result" data-result hidden><p class="eyebrow">YOUR EXPLAINABLE RESULT</p><small>PRIMARY FDE FIT</small><h2 data-fit></h2><div class="result-grid"><article><span>WHY</span><ul data-why></ul></article><article><span>GAPS TO BUILD</span><ul data-gaps></ul></article><article><span>RECOMMENDED ENTRY JOURNEY</span><strong data-journey></strong></article><article><span>FIRST PROOF</span><strong data-proof></strong></article><article><span>INTERVIEW PRIORITIES</span><ul><li>Customer discovery</li><li>System design</li><li>Production debugging</li></ul></article></div><a class="btn btn--solid" data-path href="/paths/">Open my recommended path →</a></section></div>
<script>
 const form=document.querySelector<HTMLFormElement>("[data-assessment]"); const result=document.querySelector<HTMLElement>("[data-result]");
 form?.addEventListener("submit",e=>{e.preventDefault();const scores={agent:0,platform:0,inference:0};const journeys={software:0,solutions:0,senior:0};const gaps:string[]=[];new FormData(form).forEach(raw=>{const o=JSON.parse(String(raw));for(const k of Object.keys(scores)) scores[k as keyof typeof scores]+=o[k]??0;if(o.journey)journeys[o.journey as keyof typeof journeys]+=2;if(o.gap)gaps.push(o.gap)});const key=(Object.keys(scores) as (keyof typeof scores)[]).sort((a,b)=>scores[b]-scores[a])[0];const fit={agent:"Agent / Application FDE",platform:"Enterprise / Platform FDE",inference:"Inference / ML Systems FDE"}[key];const journey=(Object.keys(journeys) as (keyof typeof journeys)[]).sort((a,b)=>journeys[b]-journeys[a])[0];const j={software:"Software / AI Engineer → FDE",solutions:"Solutions Architect / SE → FDE",senior:"Existing FDE → Senior FDE"}[journey];const slug={software:"software-engineer-to-fde",solutions:"solutions-to-fde",senior:"fde-to-senior"}[journey];document.querySelector("[data-fit]")!.textContent=fit;document.querySelector("[data-journey]")!.textContent=j;document.querySelector("[data-proof]")!.textContent=key==="inference"?"Reproducible serving benchmark":"Long-Running Agent Field Report";document.querySelector("[data-why]")!.innerHTML=`<li>Strongest signal: ${fit}</li><li>Prefers its technical boundary</li><li>Matches the selected customer environment</li>`;document.querySelector("[data-gaps]")!.innerHTML=(gaps.length?gaps:["customer discovery","evaluation evidence"]).map(x=>`<li>${x}</li>`).join("");(document.querySelector("[data-path]") as HTMLAnchorElement).href=`/paths/${slug}/`;result!.hidden=false;result!.scrollIntoView({behavior:"smooth"})});
</script></Base>
<style>.assess{max-width:900px}.assess header{padding:6rem 0 3rem}.assess h1{font-size:clamp(3.5rem,7vw,7rem)}.assess header>p:last-child{color:var(--fg-muted)}fieldset{border:0;border-top:1px solid var(--line);padding:1.5rem 0}legend{font-size:1.3rem;font-weight:650}legend span{font:500 .65rem var(--font-mono);color:var(--accent);margin-right:1rem}fieldset>div{display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem;margin-top:1rem}label{cursor:pointer}label input{position:absolute;opacity:0}label span{display:block;border:1px solid var(--line);padding:.8rem;font-size:.78rem;height:100%;background:white}label input:checked+span{border-color:var(--accent);background:#fff1e6;color:var(--accent)}.result{margin:6rem calc(50% - 50vw) 0;background:#18181b;color:white;padding:6rem max(var(--pad),calc((100vw - 900px)/2 + var(--pad)))}.result h2{color:white;font-size:clamp(2.5rem,5vw,5rem)}.result>small,.result article>span{font:500 .62rem var(--font-mono);color:#ed8a59}.result-grid{display:grid;grid-template-columns:1fr 1fr;margin:2rem 0}.result article{border:1px solid #39393f;padding:1rem}.result article strong{display:block;color:white;margin-top:1rem}.result li{color:#c2c2c8}@media(max-width:650px){fieldset>div,.result-grid{grid-template-columns:1fr}}</style>
