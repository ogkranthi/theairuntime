---
import Base from "../../layouts/Base.astro"; import {paths,specializations} from "../../data/paths";
---
<Base title="FDE Learning Paths | FDE Commons" description="Choose an entry journey and technical specialization, then build reusable skills and proof." pageSlug="paths"><div class="shell paths"><header><p class="eyebrow">PATHS</p><h1>Choose a destination,<br/>not a pile of content.</h1><p>Start from your current role and the technical boundary you want to own. Every path reuses the same rigorous learning assets and ends in evidence.</p><a class="btn btn--solid" href="/paths/assessment/">Find your FDE path →</a></header><section><p class="eyebrow">ENTRY JOURNEYS</p><div class="cards">{paths.map((p,i)=><a href={`/paths/${p.slug}/`}><span>0{i+1}</span><h2>{p.title}</h2><p>{p.description}</p><b>{p.milestones.length} milestones →</b></a>)}</div></section><section><p class="eyebrow">SPECIALIZATIONS</p><div class="cards">{specializations.map((s,i)=><a href={`/paths/specializations/${s.slug}/`}><span>0{i+1}</span><h2>{s.title}</h2><small>DEPLOYS</small><strong>{s.deploys}</strong><p>{s.summary}</p><b>Explore →</b></a>)}</div></section></div></Base>
<style>.paths{max-width:1150px}.paths header{padding:7rem 0}.paths h1{font-size:clamp(3.5rem,7vw,7rem)}.paths header>p:nth-child(3){color:var(--fg-muted);max-width:60ch}.paths section{padding:5rem 0;border-top:1px solid var(--line)}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line)}.cards a{background:#fff;color:var(--fg);padding:1.2rem;min-height:17rem;display:flex;flex-direction:column}.cards a:hover{text-decoration:none;background:#fff1e6}.cards span,.cards small{font:500 .62rem var(--font-mono);color:var(--accent)}.cards h2{margin-top:2rem}.cards p{font-size:.78rem;color:var(--fg-muted)}.cards b{font:500 .65rem var(--font-mono);color:var(--accent);margin-top:auto}@media(max-width:700px){.cards{grid-template-columns:1fr}}</style>
