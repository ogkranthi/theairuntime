---
import Base from "../../layouts/Base.astro";
const prompts=["Problem — What customer problem did the system address?","Operating context — Who uses it, where does it run, and what matters if it fails?","Constraints — Latency, cost, security, compliance, reliability, integration, and time.","Architecture — Show the system diagram, authority boundaries, and data flow.","Implementation — What did you build, and deliberately not build?","Failure model — What can fail across model, context, tools, data, infrastructure, and people?","Failure tests — What did you break intentionally, and what invariant did you expect?","Evaluation — How did you measure behavior and customer-facing quality?","Results — Show raw evidence, comparisons, and operating conditions.","Tradeoffs — What did the architecture gain and give up?","Known limitations — What remains unsafe, fragile, expensive, or unproven?","Evidence — Link repo, tests, evals, traces, screenshots, benchmarks, and deployment.","Next decision — What changes before this serves a real customer?"];
const rubric=["Problem clarity","Architecture","Failure reasoning","Evaluation","Evidence","Reproducibility","Security","Operations","Tradeoffs","Communication"];
---
<Base title="Field Report Template | FDE Commons" description="A public evidence template and self-review rubric for demonstrating forward-deployed engineering work." pageSlug="field-report"><div class="shell report"><header><p class="eyebrow">PROOF, NOT CERTIFICATION</p><h1>Publish the work.<br/>Show what remains true when it fails.</h1><p>A Field Report turns a project into inspectable evidence: problem, constraints, architecture, failures, measurements, tradeoffs, and limitations.</p></header><section><p class="eyebrow">COPYABLE STRUCTURE</p><div class="template">{prompts.map((p,i)=>{const [title,copy]=p.split(" — ");return <article><span>{String(i+1).padStart(2,"0")}</span><h2>{title}</h2><p>{copy}</p></article>})}</div></section><section class="rubric"><div><p class="eyebrow">SELF-REVIEW RUBRIC</p><h2>Grade the evidence, not your effort.</h2><div class="states"><span>Not demonstrated</span><span>Demonstrated</span><span>Strongly demonstrated</span></div></div><ol>{rubric.map((r,i)=><li><span>{String(i+1).padStart(2,"0")}</span>{r}</li>)}</ol></section><section class="finish"><h2>Ready to produce the evidence?</h2><a class="btn btn--solid" href="/learn/courses/long-running-agents/capstone/">Use the Course 001 capstone →</a></section></div></Base>
<style>.report{max-width:1000px}.report header{padding:7rem 0}.report header h1{font-size:clamp(3.5rem,7vw,7rem)}.report header>p:last-child{color:var(--fg-muted);max-width:62ch}.report>section{padding:5rem 0;border-top:1px solid var(--line)}.template{display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--line)}.template article{padding:1rem;border:1px solid var(--line);min-height:10rem}.template span,.rubric li span{font:500 .62rem var(--font-mono);color:var(--accent)}.template p{font-size:.76rem;color:var(--fg-muted)}.rubric{display:grid;grid-template-columns:1fr 1fr;gap:5rem}.states{display:flex;flex-direction:column}.states span{border:1px solid var(--line);padding:.6rem;font:500 .65rem var(--font-mono)}.rubric ol{list-style:none;padding:0}.rubric li{display:grid;grid-template-columns:2.5rem 1fr;padding:.7rem;border-top:1px solid var(--line);font-weight:650}.finish{background:#18181b;color:white;margin-inline:calc(50% - 50vw);padding-inline:max(var(--pad),calc((100vw - 1000px)/2 + var(--pad)))!important}.finish h2{color:white}@media(max-width:650px){.template,.rubric{grid-template-columns:1fr}}</style>
