---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import StateLedger from "../../components/StateLedger.astro";
import CtaBlock from "../../components/CtaBlock.astro";
import Toc from "../../components/Toc.astro";
import CourseNav from "../../components/CourseNav.astro";
import { REACH_OUT, getModules, moduleHref, neighbors, pad, utm } from "../../lib/course";

export async function getStaticPaths() {
  const modules = await getModules();
  return modules.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const modules = await getModules();
const { prev, next } = neighbors(modules, entry);
const { Content, headings } = await render(entry);

const n = entry.data.module;
const labN = entry.data.labNumber;
const metaLine = [
  entry.data.duration,
  entry.data.lab && labN !== undefined ? `Failure Lab ${pad(labN)}: ${entry.data.lab}` : null,
]
  .filter(Boolean)
  .join(" · ");

// The recognizable rhythm of every module. Rendered as a quiet strip, not a
// component per stage; the stages live in the prose.
const RHYTHM = ["BUILD", "BREAK", "DIAGNOSE", "FIX", "PROVE"];

// The reach-out line renders exactly once per page. Module 12 already carries
// it in its closing prose, so the CTA block stands down there.
const bodyHasReachOut = entry.body?.includes(REACH_OUT.slice(0, 40)) ?? false;
---

<Base
  title={`Module ${pad(n)}: ${entry.data.title} | AIR Course 001`}
  description={entry.data.goal}
  pageSlug={entry.id}
  ogType="article"
>
  <CourseNav active="module" />
  <div class="shell module">
    <div class="module__main">
      <header class="module__header">
        <p class="eyebrow">MODULE {pad(n)}</p>
        <p class="module__question">{entry.data.question}</p>
        <h1>{entry.data.title}</h1>
        {entry.data.subtitle && <p class="module__subtitle">{entry.data.subtitle}</p>}
        <p class="meta">{metaLine}</p>
        <p class="module__goal"><strong>Goal:</strong> {entry.data.goal}</p>

        {
          entry.data.invariant && (
            <p class="module__invariant">
              <span class="module__invariant-tag">INVARIANT</span> {entry.data.invariant}
            </p>
          )
        }

        <p class="module__rhythm" aria-label="Module rhythm">
          {RHYTHM.map((stage, i) => (
            <Fragment>
              {i > 0 && <span aria-hidden="true" class="module__rhythm-sep">&rarr;</span>}
              <span>{stage}</span>
            </Fragment>
          ))}
        </p>

        <div class="module__links">
          {
            entry.data.youtube && labN !== undefined && (
              <a class="btn" href={utm(entry.data.youtube, entry.id, "watch")} rel="noopener">
                <span aria-hidden="true">&#9654;</span> Watch Failure Lab {pad(labN)}
              </a>
            )
          }
          {
            entry.data.substack && (
              <a class="btn" href={utm(entry.data.substack, entry.id, "longform")} rel="noopener">
                Longform on Substack
              </a>
            )
          }
        </div>

        <StateLedger current={n} status="running" progress={true} />
      </header>

      <article class="prose">
        <Content />
      </article>

      <nav class="module__nav" aria-label="Module navigation">
        <div class="module__nav-prev">
          {
            prev ? (
              <a href={moduleHref(prev)}>
                <span class="meta">Prev</span>
                <span class="module__nav-title">
                  &larr; {pad(prev.data.module)} {prev.data.title}
                </span>
              </a>
            ) : (
              <a href="/">
                <span class="meta">Prev</span>
                <span class="module__nav-title">&larr; Course home</span>
              </a>
            )
          }
        </div>
        <div class="module__nav-next">
          {
            next ? (
              <a href={moduleHref(next)}>
                <span class="meta">Next</span>
                <span class="module__nav-title">
                  {pad(next.data.module)} {next.data.title} &rarr;
                </span>
              </a>
            ) : (
              <a href="/labs/">
                <span class="meta">Next</span>
                <span class="module__nav-title">All Failure Labs &rarr;</span>
              </a>
            )
          }
        </div>
      </nav>
    </div>

    <aside class="module__rail">
      <Toc headings={headings} />
    </aside>
  </div>

  <CtaBlock
    slot="footer-cta"
    pageSlug={entry.id}
    moduleNumber={n}
    youtube={entry.data.youtube}
    reachOut={!bodyHasReachOut}
  />
</Base>

<style>
  .module {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    padding-top: 3rem;
  }
  .module__main { min-width: 0; max-width: var(--measure); }

  .module__header { margin-bottom: 2.5rem; }
  .module__header h1 { margin-bottom: 0.5rem; }
  .module__question {
    font-family: var(--font-mono);
    font-size: var(--t-h3);
    color: var(--fg);
    margin: 0 0 1rem;
    max-width: 40ch;
    text-wrap: balance;
  }
  .module__invariant {
    font-family: var(--font-mono);
    font-size: var(--t-meta);
    color: var(--fg-muted);
    border: 1px solid var(--accent-dim);
    border-radius: var(--radius);
    padding: 0.5rem 0.75rem;
    margin: 0 0 1rem;
    max-width: fit-content;
  }
  .module__invariant-tag {
    color: var(--accent);
    letter-spacing: 0.1em;
    margin-right: 0.5rem;
  }
  .module__rhythm {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--fg-muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1.5rem;
  }
  .module__rhythm-sep { color: var(--accent); }
  .module__subtitle {
    font-size: var(--t-h3);
    color: var(--fg-muted);
    margin: 0 0 0.75rem;
  }
  .module__goal {
    color: var(--fg-muted);
    margin: 0.75rem 0 1.5rem;
    font-size: var(--t-meta);
  }
  .module__goal strong { color: var(--fg); }
  .module__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .module__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .module__nav a { display: block; }
  .module__nav a:hover { text-decoration: none; }
  .module__nav-next { text-align: right; margin-left: auto; }
  .module__nav .meta { display: block; margin-bottom: 0.25rem; }
  .module__nav-title {
    font-family: var(--font-mono);
    font-size: var(--t-meta);
    color: var(--accent);
  }

  .module__rail { display: none; }

  @media (min-width: 1024px) {
    .module {
      grid-template-columns: minmax(0, var(--measure)) minmax(0, 17rem);
      justify-content: start;
      gap: 4rem;
    }
    .module__rail { display: block; }
  }
</style>

<script define:vars={{ slug: entry.id }}>
  // Exit criteria: enable the GFM task-list checkboxes, persist each to
  // localStorage, and record the module complete when all are checked.
  // Storage: air-c001-exit-<slug> = [bool,...]; air-c001-complete = [slug,...]
  const KEY = `air-c001-exit-${slug}`;
  const block = document.querySelector(".block-exit");
  if (block) {
    const boxes = [...block.querySelectorAll('input[type="checkbox"]')];
    let saved = [];
    try {
      saved = JSON.parse(localStorage.getItem(KEY) ?? "[]");
    } catch { /* fresh */ }

    const doneNote = document.createElement("p");
    doneNote.className = "block-exit__done";
    doneNote.textContent = `MODULE ${slug.slice(0, 2)} COMPLETE. It will show as done on the syllabus.`;
    block.appendChild(doneNote);

    const sync = () => {
      const states = boxes.map((b) => b.checked);
      try {
        localStorage.setItem(KEY, JSON.stringify(states));
        const all = states.length > 0 && states.every(Boolean);
        const done = new Set(JSON.parse(localStorage.getItem("air-c001-complete") ?? "[]"));
        if (all) done.add(slug);
        else done.delete(slug);
        localStorage.setItem("air-c001-complete", JSON.stringify([...done]));
        block.classList.toggle("is-complete", all);
      } catch { /* private mode */ }
      boxes.forEach((b) => b.closest("li")?.classList.toggle("is-checked", b.checked));
    };

    boxes.forEach((box, i) => {
      box.disabled = false;
      box.checked = Boolean(saved[i]);
      // GFM task-list inputs ship without labels; name each from its line.
      box.setAttribute("aria-label", box.closest("li")?.textContent?.trim() ?? `Exit criterion ${i + 1}`);
      box.addEventListener("change", sync);
    });
    sync();
  }
</script>

<style is:global>
  /* Prose rhythm for rendered curriculum markdown. */
  .prose h2 {
    margin-top: 2.75rem;
    padding-top: 0.5rem;
    scroll-margin-top: 5rem;
  }
  .prose h3 { margin-top: 2rem; scroll-margin-top: 5rem; }
  .prose > pre { margin: 1.5rem 0; }
  .prose blockquote {
    font-family: var(--font-mono);
    font-size: var(--t-meta);
    color: var(--fg);
  }
</style>
