---
import Base from "../../layouts/Base.astro";
import CourseNav from "../../components/CourseNav.astro";
import CtaBlock from "../../components/CtaBlock.astro";

// Grouped primary sources. Each entry: [title, url, why it is worth reading].
// Modules link 1-3 of these in place; this page is the full annotated list.
const groups: [string, [string, string, string][]][] = [
  [
    "LangGraph and Deep Agents",
    [
      ["LangGraph persistence", "https://docs.langchain.com/oss/python/langgraph/persistence", "The authoritative answer to what one checkpoint contains and which tables the Postgres saver writes. Read next to your own checkpointer from Module 03."],
      ["LangGraph interrupts", "https://docs.langchain.com/oss/python/langgraph/interrupts", "Exact semantics of interrupt() and Command(resume=...), including what replays on resume. The replay behavior is the part that surprises people in Module 07."],
      ["LangGraph graph API", "https://docs.langchain.com/oss/python/langgraph/graph-api", "Where the docs themselves tell you to keep node logic idempotent, which is the bridge into Module 04."],
      ["Deep Agents overview", "https://docs.langchain.com/oss/python/deepagents/overview", "The harness Module 12 interrogates. Read the mechanisms, then map each to the module where you built it by hand."],
      ["Deep Agents context engineering", "https://docs.langchain.com/oss/python/deepagents/context-engineering", "Module 08's three techniques as framework features."],
      ["Deep Agents subagents", "https://docs.langchain.com/oss/python/deepagents/subagents", "Clean-context subagent spawning, the deep-dive pattern formalized."],
      ["Deep Agents going to production", "https://docs.langchain.com/oss/python/deepagents/going-to-production", "Compare its defaults against your own security_policy.md from Module 10."],
    ],
  ],
  [
    "Long-running harness engineering",
    [
      ["Anthropic: effective harnesses for long-running agents", "https://www.anthropic.com/engineering/effective-harnesses-for-long-running-agents", "The industry statement of the harness/runtime split this course is built around."],
      ["Anthropic: effective context engineering for AI agents", "https://www.anthropic.com/engineering/effective-context-engineering-for-ai-agents", "The published basis for Module 08's claim that compaction alone is not sufficient."],
      ["Anthropic: harness design for long-running apps", "https://www.anthropic.com/engineering/harness-design-long-running-apps", "Harness design decisions for multi-session application development."],
      ["Anthropic: scaling managed agents", "https://www.anthropic.com/engineering/managed-agents", "What running other people's agents as a service forces you to make durable."],
      ["Anthropic: multi-agent research system", "https://www.anthropic.com/engineering/multi-agent-research-system", "A production long-horizon system described with unusual candor; Module 13's first extraction case."],
    ],
  ],
  [
    "Evals",
    [
      ["Hamel Husain: LLM-as-a-judge", "https://hamel.dev/blog/posts/llm-judge/", "The methodology Module 11 follows, including judge validation against human labels. If you read one link on this page, read this."],
      ["Hamel Husain and Shreya Shankar: evals FAQ", "https://hamel.dev/blog/posts/evals-faq/", "Short answers to the exact objections your team will raise when you propose error analysis before metrics."],
    ],
  ],
  [
    "Durable workflow comparison",
    [
      ["Temporal AI integrations", "https://docs.temporal.io/integrations", "The landscape when a workflow engine owns durability instead of your tables."],
      ["Temporal durable OpenAI Agents example", "https://docs.temporal.io/ai-cookbook/openai-agents-sdk-python", "Claim, lease, heartbeat and reclaim as engine primitives; compare with your Module 05 scheduler."],
      ["Temporal human-in-the-loop example", "https://docs.temporal.io/ai-cookbook/human-in-the-loop-python", "The durable-wait pattern of Module 07 in a workflow engine, showing it is an industry invariant and not a framework quirk."],
    ],
  ],
  [
    "Current industry examples",
    [
      ["OpenAI: harness engineering", "https://openai.com/index/harness-engineering/", "The coding-agent harness architecture from the team shipping it."],
      ["OpenAI: unrolling the Codex agent loop", "https://openai.com/index/unrolling-the-codex-agent-loop/", "The agent loop of Module 01, at production scale."],
      ["OpenAI: run long-horizon tasks with Codex", "https://developers.openai.com/blog/run-long-horizon-tasks-with-codex", "Long-horizon task guidance for a shipping agent product."],
      ["Replit: evaluating and improving Agent at scale", "https://replit.com/blog/evaluating-and-improving-agent-at-scale", "Evals as the development loop, argued by someone with millions of runs."],
      ["Replit: decision-time guidance", "https://replit.com/blog/decision-time-guidance", "Steering an agent mid-trajectory rather than only at the prompt."],
      ["Replit: inside the snapshot engine", "https://replit.com/blog/inside-replits-snapshot-engine", "Durable execution machinery from a production agent platform."],
    ],
  ],
  [
    "Hosting limits",
    [
      ["Render free instance limitations", "https://render.com/docs/free", "The constraints Module 14 designs around. Verify before relying on the module's numbers."],
      ["Neon free-plan limits", "https://neon.com/docs/introduction/plans", "Connection and storage caps that shape the lease scheduler and pooling choices."],
    ],
  ],
];
---

<Base
  title="Primary Sources | AIR Course 001"
  description="The primary sources behind Course 001's framework-specific and fast-changing claims, each with a sentence on why it is worth your time."
  pageSlug="sources"
>
  <CourseNav active="sources" />
  <div class="shell">
    <section class="section">
      <p class="eyebrow">PRIMARY SOURCES</p>
      <h1>Read the originals</h1>
      <div class="measure">
        <p>
          Wherever the course makes a framework-specific or fast-changing claim, it cites a
          primary source. Modules link one to three of these in place; this page is the full
          annotated list. No link dumps: each entry says why it is worth your time.
        </p>
        <p class="muted">
          Framework and hosting pages change quickly. These links are reviewed before each
          course revision, and the repo pins the exact dependency versions the course was
          tested against.
        </p>
      </div>
    </section>

    {
      groups.map(([group, entries]) => (
        <section class="section">
          <h2>{group}</h2>
          <dl class="sources">
            {entries.map(([title, url, why]) => (
              <div class="sources__row">
                <dt><a href={url} rel="noopener">{title}</a></dt>
                <dd>{why}</dd>
              </div>
            ))}
          </dl>
        </section>
      ))
    }
  </div>

  <CtaBlock slot="footer-cta" pageSlug="sources" />
</Base>

<style>
  .sources { margin: 1rem 0 0; border-top: 1px solid var(--line); }
  .sources__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.25rem 2rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--line);
  }
  .sources dt {
    font-family: var(--font-mono);
    font-size: var(--t-meta);
  }
  .sources dd {
    margin: 0;
    font-size: var(--t-meta);
    color: var(--fg-muted);
    max-width: 68ch;
  }
  @media (min-width: 900px) {
    .sources__row { grid-template-columns: 24rem minmax(0, 1fr); }
  }
</style>
