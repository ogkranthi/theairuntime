---
import Base from "../../../layouts/Base.astro";
import FdeNav from "../../../components/FdeNav.astro";
import { fdeSegments, type FdeSegment } from "../../../data/fde";
export async function getStaticPaths(){
  return fdeSegments.map((segment) => ({ params: { slug: segment.slug }, props: { segment } }));
}
const { segment } = Astro.props as { segment: FdeSegment };
const idx = fdeSegments.findIndex((item) => item.slug === segment.slug);
const next = fdeSegments[(idx + 1) % fdeSegments.length]!;
---
<Base title={`${segment.title} | FDE Career Atlas`} description={segment.short} pageSlug={`fde-${segment.slug}`}><FdeNav/><div class="shell segment"><header><p class="eyebrow">SEGMENT {segment.number} / {segment.accent}</p><h1>{segment.title}</h1><p>{segment.short}</p><div class="deployed"><span>WHAT IS FORWARD DEPLOYED?</span><strong>{segment.deployed}</strong></div></header><main><section><p class="label">REPRESENTATIVE ORGANIZATIONS</p><div class="orgs">{segment.organizations.map(x=><span>{x}</span>)}</div></section><section><p class="label">THE WORK</p><h2>What you are likely to own</h2><ol class="work">{segment.work.map((x,i)=><li><span>{String(i+1).padStart(2,"0")}</span>{x}</li>)}</ol></section><section class="two"><div><p class="label">TECHNICAL EXPECTATION</p><h2>The useful stack</h2><div class="skills">{segment.skills.map(x=><span>{x}</span>)}</div></div><div><p class="label">CUSTOMER EXPECTATION</p><h2>Proximity to the problem</h2><p>{segment.customers}</p></div></section><section class="success"><p class="label">THE REAL SUCCESS METRIC</p><blockquote>{segment.success}</blockquote></section><section><p class="label">AIR PREPARATION FOCUS</p><h2>What to build next</h2><div class="prep">{segment.preparation.map((x,i)=><article><span>0{i+1}</span><strong>{x}</strong></article>)}</div></section></main><footer><span>NEXT SEGMENT</span><a href={`/career/segments/${next.slug}/`}>{next.title} →</a></footer></div></Base>
<style>.segment{max-width:1000px}.segment header{padding:6rem 0 4rem}.segment h1{font-size:clamp(3.5rem,7vw,7rem);max-width:12ch}.segment header>p:nth-child(3){font-size:1.2rem;color:var(--fg-muted);max-width:52ch}.deployed{margin-top:2rem;border-left:4px solid var(--accent);background:#fff1e6;padding:1rem}.deployed span,.label,.segment footer>span{display:block;font:500 .62rem var(--font-mono);letter-spacing:.1em;color:var(--accent)}.deployed strong{font-size:1.5rem}.segment main>section{padding:4rem 0;border-top:1px solid var(--line)}.orgs,.skills{display:flex;flex-wrap:wrap;gap:.5rem}.orgs span,.skills span{border:1px solid var(--line);background:white;padding:.5rem .7rem;font:500 .72rem var(--font-mono)}.work{list-style:none;padding:0}.work li{display:grid;grid-template-columns:3rem 1fr;border-top:1px solid var(--line);padding:1rem 0;font-weight:650}.work li span{font:500 .65rem var(--font-mono);color:var(--accent)}.two{display:grid;grid-template-columns:1fr 1fr;gap:5rem}.two>div:last-child p{color:var(--fg-muted)}.success{background:#18181b;color:white;margin-inline:calc(50% - 50vw);padding-inline:max(var(--pad),calc((100vw - 1000px)/2 + var(--pad)))!important}.success blockquote{border:0;padding:0;margin:1rem 0;color:white;font-size:clamp(1.8rem,4vw,3.5rem);line-height:1.2}.prep{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--line)}.prep article{padding:1rem;border-right:1px solid var(--line)}.prep span,.prep strong{display:block}.prep span{font:500 .65rem var(--font-mono);color:var(--accent)}.segment footer{padding:3rem 0 6rem}.segment footer a{font-size:1.4rem;font-weight:650}@media(max-width:700px){.two{grid-template-columns:1fr;gap:2rem}.prep{grid-template-columns:1fr 1fr}}</style>
