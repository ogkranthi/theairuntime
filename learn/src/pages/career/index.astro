---
import Base from "../../layouts/Base.astro"; import FdeNav from "../../components/FdeNav.astro"; import {fdeSegments,companies} from "../../data/fde";
const sections=[{title:"What is FDE?",copy:"The canonical definition and the three properties that matter.",href:"#definition"},{title:"Role boundaries",copy:"Distinguish FDE from solutions, applied AI, consulting, and deployment roles.",href:"/career/roles/"},{title:"Eight segments",copy:"Understand the role through what is actually forward deployed.",href:"/career/segments/"},{title:"Career progression",copy:"Grow system, customer, reuse, and organizational scope.",href:"/career/progression/"},{title:"Companies",copy:"Study how organizations structure field engineering.",href:"/career/companies/"},{title:"Interviews",copy:"Prepare for discovery, system design, debugging, and judgment.",href:"/career/interviews/"},{title:"Compensation",copy:"Read evidence carefully across location, level, and role variant.",href:"/career/compensation/"},{title:"Jobs",copy:"Inspect curated US-first sources without turning the Commons into a job board.",href:"/career/jobs/"}];
---
<Base title="Understand the FDE Profession | FDE Commons" description="Decode the FDE role family, technical segments, companies, progression, interviews, compensation, and opportunities." pageSlug="career"><FdeNav/><div class="shell career"><header><p class="eyebrow">CAREER</p><h1>Understand the FDE profession.</h1><p>Decode the role family, choose a technical segment, understand how companies deploy FDEs, prepare for interviews, and inspect current opportunities.</p></header><section class="directory">{sections.map((s,i)=><a href={s.href}><span>{String(i+1).padStart(2,"0")}</span><h2>{s.title}</h2><p>{s.copy}</p><b>→</b></a>)}</section><section class="definition" id="definition"><p class="eyebrow">CANONICAL DEFINITION</p><blockquote>A Forward Deployed Engineer is an engineer who owns technical outcomes close to the customer, building and adapting production systems in real operating environments while turning deployment learnings into reusable product or engineering improvements.</blockquote><div><span>ENGINEER</span><span>PROXIMITY</span><span>OUTCOME OWNERSHIP</span></div></section><section><div class="section-head"><div><p class="eyebrow">ROLE FAMILY</p><h2>Eight technical centers.</h2></div><a href="/career/segments/">Compare all segments →</a></div><div class="segments">{fdeSegments.map(s=><a href={`/career/segments/${s.slug}/`}><span>{s.number}</span><h3>{s.title}</h3><small>{s.deployed}</small></a>)}</div></section><section class="evidence"><div><p class="eyebrow">EVIDENCE, NOT CAREER THEATER</p><h2>Titles are weak evidence.</h2></div><p>The product boundary, code ownership, customer environment, success measure, travel expectations, and operating responsibility reveal the actual job. Company pages link primary sources and record verification dates.</p><strong>{companies.length} operating models mapped</strong></section></div></Base>
<style>.career{max-width:1150px}.career header{padding:7rem 0}.career header h1{font-size:clamp(3.5rem,7vw,7rem);max-width:13ch}.career header>p:last-child{color:var(--fg-muted);max-width:60ch}.directory{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--line)}.directory a{padding:1rem;color:var(--fg);min-height:14rem;border:1px solid var(--line);position:relative}.directory a:hover{text-decoration:none;background:#fff1e6}.directory span,.segments span{font:500 .62rem var(--font-mono);color:var(--accent)}.directory p{font-size:.72rem;color:var(--fg-muted)}.directory b{position:absolute;right:1rem;top:1rem;color:var(--accent)}.career>section:not(.directory){padding:6rem 0;border-top:1px solid var(--line)}.definition{background:#fff1e6;margin-inline:calc(50% - 50vw);padding-inline:max(var(--pad),calc((100vw - 1150px)/2 + var(--pad)))!important}.definition blockquote{border:0;padding:0;color:var(--fg);font-size:clamp(1.8rem,3.5vw,3.5rem);line-height:1.2}.definition>div{display:flex;gap:.5rem;flex-wrap:wrap}.definition span{border:1px solid #e3bca1;padding:.4rem;font:500 .62rem var(--font-mono);color:var(--accent)}.section-head,.evidence{display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:end}.segments{display:grid;grid-template-columns:repeat(4,1fr);margin-top:2rem}.segments a{color:var(--fg);padding:1rem;border:1px solid var(--line)}.segments a:hover{text-decoration:none;background:#fff1e6}.segments small{display:block;color:var(--fg-muted)}.evidence{background:#18181b;color:white;margin-inline:calc(50% - 50vw);padding-inline:max(var(--pad),calc((100vw - 1150px)/2 + var(--pad)))!important}.evidence h2{color:white}.evidence>p{color:#b8b8be}.evidence strong{color:#ed8a59}@media(max-width:800px){.directory,.segments{grid-template-columns:1fr 1fr}.section-head,.evidence{grid-template-columns:1fr}}</style>
