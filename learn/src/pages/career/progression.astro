---
import Base from "../../layouts/Base.astro"; import FdeNav from "../../components/FdeNav.astro";
const levels=[{title:"Aspiring FDE",scope:"A bounded project",signal:"Can build, explain, break, and prove one production-shaped system."},{title:"FDE",scope:"A customer outcome",signal:"Owns discovery through rollout across a real operating environment."},{title:"Senior FDE",scope:"A complex deployment",signal:"Shapes ambiguity, manages risk, and creates reusable field patterns."},{title:"Staff / Principal",scope:"A portfolio and platform",signal:"Changes architecture and product direction across deployments."},{title:"Lead / Manager",scope:"A team and operating system",signal:"Sequences people, delivery, quality, adoption, and learning."},{title:"Head of FDE",scope:"The function",signal:"Designs how field outcomes create durable company leverage."}];
---
<Base title="FDE Career Progression | FDE Commons" description="Understand increasing scope from aspiring FDE through senior, staff, leadership, and head-of-FDE roles." pageSlug="career-progression"><FdeNav/><div class="shell progression"><header><p class="eyebrow">CAREER PROGRESSION</p><h1>Seniority is increasing scope—not distance from the work.</h1><p>Titles vary. Look for growth across system complexity, customer ambiguity, reusable leverage, and organizational responsibility.</p></header><section>{levels.map((l,i)=><article><span>{String(i+1).padStart(2,"0")}</span><div><small>OWNS</small><h2>{l.title}</h2><strong>{l.scope}</strong></div><p>{l.signal}</p></article>)}</section><footer><h2>Ready to move from delivery to leverage?</h2><a class="btn btn--solid" href="/paths/fde-to-senior/">Open the Senior FDE path →</a></footer></div></Base>
<style>.progression{max-width:1000px}.progression header{padding:7rem 0}.progression h1{font-size:clamp(3.5rem,7vw,7rem);max-width:14ch}.progression header>p:last-child{color:var(--fg-muted)}.progression section{border-top:1px solid var(--line)}.progression article{display:grid;grid-template-columns:3rem 1fr 1fr;gap:2rem;padding:1.5rem;border-bottom:1px solid var(--line)}article>span,article small{font:500 .62rem var(--font-mono);color:var(--accent)}article h2{margin:.2rem 0}article strong{color:var(--accent)}article p{color:var(--fg-muted)}.progression footer{background:#18181b;color:white;margin:4rem calc(50% - 50vw) 0;padding:5rem max(var(--pad),calc((100vw - 1000px)/2 + var(--pad)))}.progression footer h2{color:white}@media(max-width:600px){.progression article{grid-template-columns:2rem 1fr}.progression article p{grid-column:2}}</style>
