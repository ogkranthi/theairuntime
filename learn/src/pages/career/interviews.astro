---
import Base from "../../layouts/Base.astro"; import FdeNav from "../../components/FdeNav.astro";
const loops=[{title:"Discovery",prompt:"Turn an ambiguous request into users, constraints, risks, and an observable outcome.",strong:"Asks before solving; distinguishes stated request from operational job."},{title:"System design",prompt:"Design across product, customer systems, security, data, operations, and rollout.",strong:"Names boundaries, failure modes, tradeoffs, and what stays manual."},{title:"Production debugging",prompt:"Diagnose a failure that could come from model, context, tool, data, code, or infrastructure.",strong:"Builds a timeline, tests hypotheses, and protects the customer while learning."},{title:"Build / code",prompt:"Create a narrow working artifact under time pressure.",strong:"Ships readable, testable code and explains deliberate omissions."},{title:"Customer judgment",prompt:"Navigate disagreement, scope, risk, and an imperfect path to value.",strong:"Balances trust, speed, reversibility, and measurable learning."},{title:"Field learning",prompt:"Turn a one-off deployment lesson into reusable product leverage.",strong:"Separates customer-specific configuration from a repeatable primitive."}];
---
<Base title="FDE Interview Preparation | FDE Commons" description="Prepare for FDE discovery, system design, production debugging, building, customer judgment, and field-learning interviews." pageSlug="career-interviews"><FdeNav/><div class="shell interviews"><header><p class="eyebrow">INTERVIEW READINESS</p><h1>Show how you reason when the problem is incomplete.</h1><p>FDE interviews reward pragmatic engineering under ambiguity. Practice the decision, not a memorized framework.</p></header><section class="loops">{loops.map((l,i)=><article><span>{String(i+1).padStart(2,"0")}</span><h2>{l.title}</h2><p>{l.prompt}</p><footer><b>STRONG SIGNAL</b>{l.strong}</footer></article>)}</section><section class="story"><div><p class="eyebrow">YOUR EVIDENCE STORY</p><h2>Bring one system you can interrogate deeply.</h2></div><ol><li>What user outcome mattered?</li><li>What constraint changed the architecture?</li><li>What failed in production or testing?</li><li>How did you diagnose it?</li><li>What evidence proved the fix?</li><li>What would you change for the next customer?</li></ol></section><section class="cta"><h2>Need an evidence-backed project?</h2><a class="btn btn--solid" href="/practice/field-report/">Build a Field Report →</a></section></div></Base>
<style>.interviews{max-width:1050px}.interviews header{padding:7rem 0}.interviews h1{font-size:clamp(3.5rem,7vw,7rem);max-width:13ch}.interviews header>p:last-child{color:var(--fg-muted)}.loops{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line)}.loops article{padding:1rem;border:1px solid var(--line);min-height:16rem;display:flex;flex-direction:column}.loops article>span,.loops footer b{font:500 .62rem var(--font-mono);color:var(--accent)}.loops p,.loops footer{font-size:.75rem;color:var(--fg-muted)}.loops footer{margin-top:auto;border-top:1px solid var(--line);padding-top:.6rem}.loops footer b{display:block}.interviews>section:not(.loops){padding:5rem 0;border-top:1px solid var(--line)}.story{display:grid;grid-template-columns:1fr 1fr;gap:4rem}.story ol{list-style:none}.story li{border-top:1px solid var(--line);padding:.7rem}.cta{background:#18181b;color:white;margin-inline:calc(50% - 50vw);padding-inline:max(var(--pad),calc((100vw - 1050px)/2 + var(--pad)))!important}.cta h2{color:white}@media(max-width:700px){.loops{grid-template-columns:1fr 1fr}.story{grid-template-columns:1fr}}</style>
