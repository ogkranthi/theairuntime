---
import Base from "../../layouts/Base.astro"; import FdeNav from "../../components/FdeNav.astro"; import {companies} from "../../data/fde";
---
<Base title="Live FDE Openings | FDE Career Atlas" description="A time-sensitive launchpad to official FDE career pages, deliberately separated from the durable Career Atlas." pageSlug="fde-jobs"><FdeNav/><div class="shell jobs"><header><p class="eyebrow">TIME-SENSITIVE LAYER</p><h1>Openings expire.<br/>The career model should not.</h1><p>This page is deliberately separate from the durable Atlas. It sends you to official career sources instead of copying stale listings into a generic job board.</p><div class="stamp"><span>LAST RESEARCH SYNTHESIS</span><strong>August 15, 2026</strong><small>Always verify title, location, seniority, compensation, and availability at the source.</small></div></header><section><h2>Official career launchpad</h2><div class="openings">{companies.map(c=><a href={c.source} rel="noopener"><span>{c.family}</span><h3>{c.name}</h3><p>{c.variants}</p><b>Check current roles ↗</b></a>)}</div></section><section class="check"><div><p class="eyebrow">BEFORE YOU APPLY</p><h2>Inspect the job beneath the label.</h2></div><ul><li><b>Artifact</b>What will you personally ship?</li><li><b>Boundary</b>Where does custom work stop and product begin?</li><li><b>Code</b>How much production code will you own?</li><li><b>Customer</b>Who is the real user and how close are you?</li><li><b>Operations</b>Who owns incidents, support, travel, and adoption?</li><li><b>Success</b>Is performance measured by demos, launch, usage, or outcome?</li></ul></section><section class="cta"><p>Not ready to apply yet?</p><h2>Choose the segment first. Then build the proof.</h2><div><a class="btn btn--solid" href="/career/segments/">Find your FDE segment</a><a class="btn" href="/paths/">Open the skills map</a></div></section></div></Base>
<style>.jobs{max-width:1100px}.jobs header{padding:6rem 0}.jobs header h1{font-size:clamp(3.2rem,6vw,6rem);max-width:14ch}.jobs header>p:nth-child(3){color:var(--fg-muted);max-width:60ch}.stamp{display:grid;grid-template-columns:auto 1fr;gap:.2rem 1rem;border-left:4px solid var(--accent);background:#fff1e6;padding:1rem;max-width:42rem;margin-top:2rem}.stamp span{font:500 .62rem var(--font-mono);color:var(--accent)}.stamp small{grid-column:2;color:var(--fg-muted)}.jobs section{padding:4rem 0;border-top:1px solid var(--line)}.openings{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--line);border:1px solid var(--line)}.openings a{background:white;color:var(--fg);padding:1rem}.openings a:hover{text-decoration:none;background:#fff1e6}.openings span{font:500 .62rem var(--font-mono);color:var(--accent)}.openings p{font-size:.72rem;color:var(--fg-muted)}.openings b{font:500 .65rem var(--font-mono);color:var(--accent)}.check{display:grid;grid-template-columns:.7fr 1.3fr;gap:5rem}.check ul{list-style:none;padding:0}.check li{display:grid;grid-template-columns:7rem 1fr;padding:.8rem 0;border-top:1px solid var(--line);font-size:.8rem}.check b{color:var(--accent)}.cta{background:#18181b;color:white;margin:2rem calc(50% - 50vw) 0;padding-inline:max(var(--pad),calc((100vw - 1100px)/2 + var(--pad)))!important}.cta h2{color:white;font-size:clamp(2rem,4vw,4rem)}.cta p{color:#ed8a59;font:500 .7rem var(--font-mono)}.cta>div{display:flex;gap:.7rem;flex-wrap:wrap}@media(max-width:700px){.openings,.check{grid-template-columns:1fr}}</style>
