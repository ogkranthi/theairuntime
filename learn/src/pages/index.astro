---
import Base from "../layouts/Base.astro";
import { CHANNELS } from "../lib/course";
import { concepts, patterns } from "../data/knowledge";

const entryPoints = [
  { label: "Understand", time: "10 min", title: "Concepts", copy: "Precise mental models for production systems.", href: "/concepts/", icon: "◎" },
  { label: "Apply", time: "30 min", title: "Patterns", copy: "Reusable decisions, invariants, and tradeoffs.", href: "/patterns/", icon: "⌘" },
  { label: "Trace", time: "1 hour", title: "Systems", copy: "Architecture teardowns from problem to operations.", href: "/systems/", icon: "◇" },
  { label: "Master", time: "15 hours", title: "Courses", copy: "Connected, end-to-end engineering expertise.", href: "/courses/", icon: "↗" },
];

const coursePath = [
  { n: "01", title: "Mental models", meta: "Why long-running agents fail" },
  { n: "03", title: "Durable execution", meta: "Checkpoint and replay" },
  { n: "05", title: "Work ownership", meta: "Lease, heartbeat, recovery" },
  { n: "08", title: "Context", meta: "Artifacts and compaction" },
  { n: "11", title: "Evaluation", meta: "Outcomes and trajectories" },
  { n: "15", title: "Production gauntlet", meta: "Prove every invariant" },
];
---
<Base title="The Open Curriculum for Production AI Engineering | AIR Learn" description="Learn how reliable AI systems are designed, evaluated, deployed, and operated. Free, practical, and built from real production systems." pageSlug="home" jsonLd={ [{"@context":"https://schema.org","@type":"WebSite",name:"The AI Runtime Learn",url:"https://learn.theairuntime.com/"}] }>
  <div class="home-shell">
    <section class="hero">
      <div class="hero__main">
        <p class="kicker"><span>OPEN CURRICULUM</span><b>FREE · NO SIGNUP</b></p>
        <h1>Learn to engineer AI systems that <em>keep working.</em></h1>
        <p class="hero__lede">Production AI engineering, explained from first principles—then tested against the failures that demos ignore.</p>
        <div class="hero__actions">
          <a class="action action--primary" href="/courses/long-running-agents/"><span>Start Course 001</span><small>Begin with the mental model</small><b>→</b></a>
          <a class="action" href="#choose"><span>Choose your depth</span><small>Learn in 10 minutes to 15 hours</small><b>↓</b></a>
        </div>
        <div class="trust"><span><b>16</b> modules</span><span><b>14</b> failure labs</span><span><b>25</b> concepts + patterns</span><span><b>0</b> prerequisites</span></div>
      </div>

      <aside class="runtime" aria-label="Production runtime learning model">
        <div class="runtime__bar"><span><i></i><i></i><i></i></span><b>RUN_001 / HEALTHY</b></div>
        <div class="runtime__body">
          <p class="runtime__label">THE SYSTEM YOU WILL BUILD</p>
          <div class="node node--input"><small>customer problem</small><strong>Resolve incident #284</strong></div>
          <div class="connector"><span>context</span></div>
          <div class="runtime__grid">
            <div class="node"><small>CONTROL</small><strong>Agent harness</strong><em>budget · policy · tools</em></div>
            <div class="node"><small>STATE</small><strong>Durable execution</strong><em>checkpoint · replay</em></div>
            <div class="node"><small>OWNERSHIP</small><strong>Lease + recover</strong><em>heartbeat · fencing</em></div>
            <div class="node"><small>PROOF</small><strong>Evaluation</strong><em>evidence · trajectory</em></div>
          </div>
          <div class="runtime__status"><span><i></i> survives restart</span><span><i></i> side effects safe</span><span><i></i> evidence attached</span></div>
        </div>
      </aside>
    </section>

    <section class="choose" id="choose">
      <header class="section-title"><div><p>LEARN BY DEPTH</p><h2>Start with the time you have.</h2></div><span>Every path connects to the same production system.</span></header>
      <div class="entry-grid">
        {entryPoints.map((item) => <a class="entry" href={item.href}>
          <div class="entry__top"><span>{item.icon}</span><small>{item.time}</small></div><p>{item.label}</p><h3>{item.title}</h3><div>{item.copy}</div><b>Explore {item.title.toLowerCase()} →</b>
        </a>)}
        <a class="entry entry--lab" href={CHANNELS.lab} rel="noopener"><div class="entry__top"><span>⚗</span><small>hands-on</small></div><p>Prove</p><h3>FDE Lab</h3><div>Break the system. Measure the failure. Publish the evidence.</div><b>Enter the lab ↗</b></a>
      </div>
    </section>

    <section class="course">
      <div class="course__intro">
        <p class="overline">START HERE · FLAGSHIP COURSE</p>
        <span class="course__number">001</span>
        <h2>Engineering Long-Running AI Agents</h2>
        <p>Follow one system from a fragile loop to a durable production runtime. Each module adds a capability, exposes a failure, and leaves you with an invariant you can test.</p>
        <div class="levels"><span><b>01</b> Understand</span><i>→</i><span><b>02</b> Explore</span><i>→</i><span><b>03</b> Build</span></div>
        <a class="button" href="/courses/long-running-agents/">Open the course <span>→</span></a>
      </div>
      <div class="course__path">
        <p class="path-label"><span>LEARNING PATH</span><b>6 milestones shown · 16 total</b></p>
        {coursePath.map((item, i) => <a href={`/courses/long-running-agents/${item.n === "01" ? "00-mental-model" : item.n === "03" ? "03-durable-execution" : item.n === "05" ? "05-work-ownership" : item.n === "08" ? "08-context" : item.n === "11" ? "11-evaluation" : "15-production-gauntlet"}/`}><span>{item.n}</span><div><strong>{item.title}</strong><small>{item.meta}</small></div><i>{i === coursePath.length - 1 ? "✓" : "→"}</i></a>)}
      </div>
    </section>

    <section class="library">
      <header class="section-title"><div><p>THE KNOWLEDGE BASE</p><h2>Find the idea. See the failure. Use the pattern.</h2></div><span>Short, canonical references built for work—not content consumption.</span></header>
      <div class="library__grid">
        <div class="library__list"><div class="list-head"><span>CONCEPTS / WHAT IT IS</span><a href="/concepts/">View all {concepts.length} →</a></div>{concepts.slice(0,6).map((item, i) => <a href={`/concepts/${item.slug}/`}><span>{String(i+1).padStart(2,"0")}</span><div><strong>{item.title}</strong><small>{item.summary}</small></div><b>{item.module.split(" · ")[0]}</b></a>)}</div>
        <div class="library__list"><div class="list-head"><span>PATTERNS / WHEN TO USE IT</span><a href="/patterns/">View all {patterns.length} →</a></div>{patterns.slice(0,6).map((item, i) => <a href={`/patterns/${item.slug}/`}><span>{String(i+1).padStart(2,"0")}</span><div><strong>{item.title}</strong><small>{item.summary}</small></div><b>{item.module.split(" · ")[0]}</b></a>)}</div>
      </div>
    </section>

    <section class="proof">
      <div><p>THE AIR METHOD</p><h2>Knowledge is not the finish line.<br/><em>Proof is.</em></h2></div>
      <ol><li><span>01</span><b>Learn</b><small>Build the mental model</small></li><li><span>02</span><b>Trace</b><small>Study a real system</small></li><li><span>03</span><b>Break</b><small>Run the failure lab</small></li><li><span>04</span><b>Prove</b><small>Publish the Field Report</small></li></ol>
      <a href={CHANNELS.lab} rel="noopener">Take it to the FDE Lab <span>↗</span></a>
    </section>
  </div>
</Base>

<style>
  .home-shell{max-width:1440px;margin:auto;padding:0 clamp(1rem,3vw,2.5rem)}
  .hero{min-height:calc(100vh - 4rem);display:grid;grid-template-columns:minmax(0,1.05fr) minmax(28rem,.95fr);gap:clamp(3rem,7vw,7rem);align-items:center;padding:clamp(4rem,8vw,8rem) 0 5rem}.kicker{display:flex;gap:1rem;align-items:center;font:500 .69rem var(--font-mono);letter-spacing:.12em}.kicker span{background:var(--fg);color:white;padding:.4rem .6rem}.kicker b{color:var(--accent);font-weight:500}.hero h1{font-size:clamp(3.6rem,6.7vw,7.4rem);line-height:.91;letter-spacing:-.068em;max-width:10ch;margin:.3em 0}.hero h1 em{font-style:normal;color:var(--accent)}.hero__lede{font-size:clamp(1.1rem,1.5vw,1.35rem);line-height:1.55;color:var(--fg-muted);max-width:56ch}.hero__actions{display:flex;gap:.65rem;margin:2rem 0}.action{min-width:14rem;border:1px solid var(--line);padding:.8rem 1rem;display:grid;grid-template-columns:1fr auto;color:var(--fg);background:white}.action:hover,.entry:hover{border-color:var(--accent);text-decoration:none}.action span{font-weight:650}.action small{font:400 .68rem var(--font-mono);color:var(--fg-muted);grid-row:2}.action b{grid-column:2;grid-row:1/3;align-self:center;color:var(--accent)}.action--primary{background:var(--accent);border-color:var(--accent);color:white}.action--primary small,.action--primary b{color:#fff}.trust{display:flex;gap:1.25rem;flex-wrap:wrap;font:400 .66rem var(--font-mono);color:var(--fg-muted)}.trust b{color:var(--fg)}
  .runtime{background:var(--code-bg);color:var(--code-fg);border:1px solid #343439;border-radius:12px;box-shadow:14px 14px 0 var(--accent-dim);overflow:hidden}.runtime__bar{height:2.6rem;border-bottom:1px solid #343439;display:flex;justify-content:space-between;align-items:center;padding:0 1rem;font:500 .6rem var(--font-mono);color:#9a9aa2}.runtime__bar span{display:flex;gap:.35rem}.runtime__bar i{width:.5rem;height:.5rem;border-radius:50%;background:#44444a}.runtime__bar i:last-child{background:#68a97d}.runtime__body{padding:1.5rem}.runtime__label{font:400 .61rem var(--font-mono);letter-spacing:.12em;color:#8e8e97}.node{border:1px solid #3a3a40;padding:.85rem;background:#1d1d21}.node small,.node em{display:block;font:400 .58rem var(--font-mono);color:#8f8f98}.node strong{display:block;color:white;font-size:.8rem;margin:.15rem 0}.node em{font-style:normal;color:#d78356}.node--input{border-left:3px solid var(--accent)}.connector{height:2.5rem;border-left:1px dashed #55555d;margin-left:1.5rem;display:flex;align-items:center}.connector span{font:400 .55rem var(--font-mono);color:#767680;background:var(--code-bg);padding:.2rem;margin-left:.5rem}.runtime__grid{display:grid;grid-template-columns:1fr 1fr;gap:.55rem}.runtime__status{display:flex;gap:.8rem;flex-wrap:wrap;margin-top:1.2rem;font:400 .55rem var(--font-mono);color:#a9a9b0}.runtime__status i{display:inline-block;width:.4rem;height:.4rem;border-radius:50%;background:#68a97d;margin-right:.25rem}
  .choose,.library{padding:7rem 0}.section-title{display:flex;justify-content:space-between;align-items:end;gap:3rem;margin-bottom:2.2rem}.section-title p,.overline,.proof>div>p{font:500 .68rem var(--font-mono);letter-spacing:.12em;color:var(--accent)}.section-title h2{font-size:clamp(2.2rem,4vw,4rem);max-width:17ch}.section-title>span{max-width:32ch;color:var(--fg-muted);font-size:.9rem}.entry-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:1px;background:var(--line);border:1px solid var(--line)}.entry{background:white;color:var(--fg);padding:1.25rem;min-height:19rem;display:flex;flex-direction:column;border-top:3px solid transparent}.entry__top{display:flex;justify-content:space-between}.entry__top>span{font:400 1.5rem var(--font-mono);color:var(--accent)}.entry__top small,.entry>p{font:500 .63rem var(--font-mono);text-transform:uppercase;letter-spacing:.1em;color:var(--fg-muted)}.entry>p{margin-top:auto;margin-bottom:.3rem;color:var(--accent)}.entry h3{font-size:1.65rem}.entry>div:not(.entry__top){font-size:.78rem;color:var(--fg-muted);line-height:1.5}.entry>b{font:500 .67rem var(--font-mono);margin-top:1.2rem}.entry--lab{background:var(--fg);color:white}.entry--lab h3,.entry--lab b{color:white}.entry--lab>div:not(.entry__top){color:#b7b7bd}
  .course{display:grid;grid-template-columns:.9fr 1.1fr;background:var(--fg);color:white;margin:0 calc(50% - 50vw);padding:7rem max(clamp(1rem,3vw,2.5rem),calc((100vw - 1440px)/2 + 2.5rem));gap:clamp(4rem,8vw,9rem)}.course__intro{position:relative}.course__number{position:absolute;right:0;top:-4rem;font:500 clamp(5rem,12vw,11rem) var(--font-mono);color:#29292d;line-height:1}.course h2{position:relative;color:white;font-size:clamp(2.7rem,5vw,5.2rem);line-height:.98;max-width:10ch}.course__intro>p:not(.overline){color:#b9b9c0;max-width:48ch}.levels{display:flex;gap:.8rem;align-items:center;flex-wrap:wrap;font-size:.75rem;margin:2rem 0}.levels b{font:400 .6rem var(--font-mono);color:#d78356;margin-right:.25rem}.levels i{font-style:normal;color:#55555d}.button{display:inline-flex;justify-content:space-between;gap:4rem;background:var(--accent);color:white;padding:1rem 1.2rem;font-weight:650;min-width:17rem}.button:hover{text-decoration:none;background:#a9360a}.course__path{align-self:center;border-top:1px solid #38383e}.path-label{display:flex;justify-content:space-between!important;font:400 .62rem var(--font-mono);color:#898992!important;padding:1rem 0;margin:0!important}.course__path>a{display:grid;grid-template-columns:2.5rem 1fr auto;align-items:center;color:white;border-top:1px solid #303035;padding:1rem .4rem}.course__path>a:hover{background:#202024;text-decoration:none}.course__path>a>span{font:400 .7rem var(--font-mono);color:#d78356}.course__path strong,.course__path small{display:block}.course__path small{font:400 .62rem var(--font-mono);color:#898992}.course__path i{font-style:normal;color:#d78356}
  .library__grid{display:grid;grid-template-columns:1fr 1fr;gap:2rem}.library__list{border:1px solid var(--line);background:white}.list-head{display:flex;justify-content:space-between;padding:.8rem 1rem;background:var(--bg-inset);font:500 .62rem var(--font-mono)}.list-head a{color:var(--accent)}.library__list>a{display:grid;grid-template-columns:2.3rem 1fr auto;gap:.5rem;padding:1rem;color:var(--fg);border-top:1px solid var(--line);align-items:start}.library__list>a:hover{background:#fff8f3;text-decoration:none}.library__list>a>span,.library__list>a>b{font:400 .61rem var(--font-mono);color:var(--accent)}.library__list strong,.library__list small{display:block}.library__list small{font-size:.7rem;line-height:1.4;color:var(--fg-muted);margin-top:.15rem}.library__list>a>b{color:var(--fg-muted);font-weight:400}
  .proof{margin:0 0 5rem;border:1px solid var(--line);padding:clamp(2rem,5vw,5rem);display:grid;grid-template-columns:.8fr 1.2fr;gap:4rem;position:relative;background:white}.proof h2{font-size:clamp(2rem,4vw,4.3rem)}.proof h2 em{font-style:normal;color:var(--accent)}.proof ol{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:1fr 1fr}.proof li{padding:1rem;border-left:1px solid var(--line);border-bottom:1px solid var(--line)}.proof li span,.proof li small,.proof li b{display:block}.proof li span{font:400 .62rem var(--font-mono);color:var(--accent)}.proof li b{font-size:1.2rem}.proof li small{font-size:.7rem;color:var(--fg-muted)}.proof>a{position:absolute;left:clamp(2rem,5vw,5rem);bottom:clamp(2rem,5vw,5rem);font:500 .72rem var(--font-mono)}
  @media(max-width:1050px){.hero{grid-template-columns:1fr;min-height:auto}.hero__main{max-width:55rem}.runtime{max-width:44rem}.entry-grid{grid-template-columns:repeat(3,1fr)}.course{grid-template-columns:1fr}.proof{grid-template-columns:1fr}.proof>a{position:static}.library__grid{grid-template-columns:1fr}}
  @media(max-width:680px){.hero{padding-top:3.5rem}.hero h1{font-size:3.6rem}.hero__actions{flex-direction:column}.action{width:100%}.runtime__body{padding:1rem}.entry-grid{grid-template-columns:1fr}.entry{min-height:12rem}.section-title{display:block}.section-title>span{display:block;margin-top:1rem}.course{padding-top:5rem;padding-bottom:5rem}.course__number{top:-2rem}.library__list>a{grid-template-columns:2rem 1fr}.library__list>a>b{display:none}.proof{padding-bottom:2rem}.proof ol{grid-template-columns:1fr}}
</style>
