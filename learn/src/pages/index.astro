---
import Base from "../layouts/Base.astro";
import { paths, specializations } from "../data/paths";
const outcomes=[{title:"Clarity",question:"Which FDE path fits me?",href:"/paths/assessment/",mark:"01"},{title:"Capability",question:"Can I actually do the work?",href:"/learn/",mark:"02"},{title:"Proof",question:"Can I show evidence?",href:"/practice/",mark:"03"},{title:"Readiness",question:"Can I interview and compete?",href:"/career/interviews/",mark:"04"}];
---
<Base title="FDE Commons: open learning for Forward Deployed Engineering" description="Understand the FDE profession, build production capability, prove what you can do, and find the right opportunities." pageSlug="home">
<div class="commons">
 <section class="hero"><p class="eyebrow">FDE COMMONS · BY THE AI RUNTIME</p><h1>Build your <em>FDE career.</em></h1><p class="lede">Understand the role. Build production capability.<br/>Prove what you can do. Find the right opportunities.</p><div class="actions"><a class="btn btn--solid" href="/paths/assessment/">Find your FDE path →</a><a class="btn" href="/career/roles/">Explore FDE roles</a></div><p class="trust">FREE · NO SIGNUP · EVIDENCE-FIRST · PRACTITIONER-INFORMED</p></section>
 <section class="outcomes">{outcomes.map(o=><a href={o.href}><span>{o.mark}</span><h2>{o.title}</h2><p>{o.question}</p><b>→</b></a>)}</section>
 <section class="assessment"><div><p class="eyebrow">WHERE DO I FIT?</p><h2>Start with your experience, not a content catalog.</h2><p>Answer ten transparent questions. Get a primary segment, the gaps to build, an entry journey, a first proof, and interview priorities. No account. No fake match percentage.</p><a class="btn btn--solid" href="/paths/assessment/">Take the 4-minute assessment →</a></div><aside><span>YOUR RESULT</span><strong>Primary FDE fit</strong><h3>Agent / Application FDE</h3><ol><li>Why it fits</li><li>Gaps to build</li><li>Recommended journey</li><li>First proof</li></ol></aside></section>
 <section class="section-block"><header><p class="eyebrow">THREE ENTRY JOURNEYS</p><h2>Choose the transition you are making.</h2></header><div class="journey-grid">{paths.map((p,i)=><a href={`/paths/${p.slug}/`}><span>0{i+1}</span><small>{p.audience}</small><h3>{p.title}</h3><p>{p.description}</p><b>Open journey →</b></a>)}</div></section>
 <section class="section-block specs"><header><p class="eyebrow">TECHNICAL SPECIALIZATIONS</p><h2>What do you want to forward deploy?</h2></header><div>{specializations.map((s,i)=><a href={`/paths/specializations/${s.slug}/`}><span>0{i+1}</span><h3>{s.title}</h3><small>DEPLOYS</small><strong>{s.deploys}</strong><p>{s.summary}</p><b>Explore specialization →</b></a>)}</div></section>
 <section class="loop"><div><p class="eyebrow">THE COMMONS LOOP</p><h2>Learning ends in evidence.</h2></div><ol><li><span>01</span><b>Learn</b><small>Build the mental model</small></li><li><span>02</span><b>Practice</b><small>Diagnose realistic failure</small></li><li><span>03</span><b>Prove</b><small>Publish the evidence</small></li><li><span>04</span><b>Career</b><small>Apply it to the right role</small></li></ol></section>
 <section class="courses"><header><p class="eyebrow">FLAGSHIP COURSES</p><h2>Two courses. One production standard.</h2><p>Both are free, readable end to end, and built around a single system rather than a catalog of disconnected demos.</p></header><div class="courses__grid">
  <article><p class="eyebrow">COURSE 001</p><h3>Engineering Long-Running AI Agents</h3><p>Build one customer-shaped workflow that is bounded, observable, recoverable, evidence-backed, cost-aware, and useful when the happy path ends.</p><ul><li>16 modules</li><li>14 failure labs</li><li>15-20 hours</li></ul><a class="btn btn--solid" href="/learn/courses/long-running-agents/">Start Course 001 →</a></article>
  <article><p class="eyebrow">COURSE 002 · NEW</p><h3>Agentic AI System Design</h3><p>Design agentic systems from first principles: authority, tool contracts, context, durable state, security, evaluation, and operations. You build one system, Atlas, end to end.</p><ul><li>17 modules</li><li>12 timed practice scenarios</li><li>35-45 hours</li></ul><a class="btn btn--solid" href="/learn/courses/agentic-system-design/">Start Course 002 →</a></article>
 </div></section>
 <section class="career"><div><p class="eyebrow">CAREER INTELLIGENCE</p><h2>Understand the profession behind the title.</h2></div><div><a href="/career/roles/">Role boundaries <span>→</span></a><a href="/career/segments/">Eight market segments <span>→</span></a><a href="/career/companies/">Company dossiers <span>→</span></a><a href="/career/interviews/">Interview preparation <span>→</span></a><a href="/career/jobs/">Curated openings <span>→</span></a></div></section>
 <section class="quality"><p class="eyebrow">THE QUALITY BAR</p><blockquote>Not a certificate mill. Not framework hype. Not career theater.</blockquote><p>FDE Commons teaches from first principles, uses primary evidence, names tradeoffs and limitations, breaks systems on purpose, and asks learners to publish reproducible proof.</p><a href="/about/">How the Commons is built →</a></section>
 <section class="ecosystem"><span>THE AI RUNTIME</span><i>→</i><span>FDE COMMONS</span><i>→</i><span>FDE LAB</span><small>ideas → capability → proof</small></section>
</div></Base>
<style>.commons{max-width:1320px;margin:auto;padding:0 var(--pad)}.hero{min-height:40rem;display:flex;flex-direction:column;justify-content:center}.hero h1{font-size:clamp(4rem,9vw,9rem);line-height:.88;letter-spacing:-.075em}.hero h1 em{font-style:normal;color:var(--accent)}.lede{font-size:clamp(1.1rem,2vw,1.45rem);color:var(--fg-muted)}.actions{display:flex;gap:.7rem;flex-wrap:wrap;margin:1rem 0 2rem}.trust{font:500 .65rem var(--font-mono);color:var(--fg-muted)}.outcomes{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--line)}.outcomes a{padding:1.2rem;color:var(--fg);border-right:1px solid var(--line);position:relative}.outcomes a:hover,.journey-grid a:hover,.specs a:hover{text-decoration:none;background:#fff1e6}.outcomes span,.journey-grid span,.specs a>span{font:500 .65rem var(--font-mono);color:var(--accent)}.outcomes h2{margin-top:2rem}.outcomes b{position:absolute;right:1rem;top:1rem;color:var(--accent)}.assessment{display:grid;grid-template-columns:1fr 1fr;gap:7vw;align-items:center;padding:7rem 0}.assessment>div>p:not(.eyebrow){color:var(--fg-muted);max-width:55ch}.assessment h2,.section-block h2,.loop h2,.career h2{font-size:clamp(2.4rem,5vw,5rem)}.assessment aside{background:#18181b;color:white;border-top:5px solid var(--accent);padding:2rem}.assessment aside span{font:500 .62rem var(--font-mono);color:#ed8a59}.assessment aside strong{display:block;color:#a7a7ae;font-size:.8rem;margin-top:1.5rem}.assessment aside h3{color:white;font-size:2rem}.assessment aside li{border-top:1px solid #39393f;padding:.5rem}.section-block{padding:6rem 0;border-top:1px solid var(--line)}.section-block header{display:flex;justify-content:space-between;align-items:end}.journey-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line);margin-top:2rem}.journey-grid a{background:white;color:var(--fg);padding:1.2rem;min-height:18rem;display:flex;flex-direction:column}.journey-grid small{color:var(--fg-muted);font-size:.65rem;margin-top:1.5rem}.journey-grid p{font-size:.78rem;color:var(--fg-muted)}.journey-grid b{margin-top:auto;color:var(--accent);font:500 .65rem var(--font-mono)}.specs>div{display:grid;grid-template-columns:repeat(3,1fr);margin-top:2rem}.specs a{color:var(--fg);padding:1.3rem;border-left:1px solid var(--line)}.specs small,.specs strong{display:block}.specs small{font:500 .6rem var(--font-mono);color:var(--accent);margin-top:2rem}.specs p{font-size:.78rem;color:var(--fg-muted)}.specs b{font:500 .65rem var(--font-mono);color:var(--accent)}.loop{background:#18181b;color:white;margin:0 calc(50% - 50vw);padding:6rem max(var(--pad),calc((100vw - 1320px)/2 + var(--pad)));display:grid;grid-template-columns:.7fr 1.3fr;gap:5rem}.loop h2{color:white}.loop ol{display:grid;grid-template-columns:1fr 1fr;list-style:none;padding:0}.loop li{border:1px solid #38383e;padding:1rem;margin:0}.loop li span,.loop li b,.loop li small{display:block}.loop li span{font:500 .62rem var(--font-mono);color:#ed8a59}.loop li b{color:white;font-size:1.2rem}.loop li small{color:#9999a1}.courses{padding:7rem 0}.courses>header>p:not(.eyebrow){color:var(--fg-muted);max-width:60ch}.courses__grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--line);border:1px solid var(--line);margin-top:2.5rem}.courses__grid article{background:white;padding:2rem;display:flex;flex-direction:column}.courses__grid h3{font-size:clamp(1.6rem,3vw,2.2rem);max-width:16ch}.courses__grid p:not(.eyebrow){color:var(--fg-muted);font-size:.9rem}.courses__grid ul{list-style:none;padding:0;margin:1rem 0 2rem;display:flex;flex-wrap:wrap;gap:.4rem 1.2rem}.courses__grid li{font:500 .68rem var(--font-mono);color:var(--accent);margin:0}.courses__grid .btn{margin-top:auto;align-self:flex-start}.career{display:grid;grid-template-columns:1fr 1fr;gap:5rem;padding:6rem 0;border-top:1px solid var(--line)}.career>div:last-child{display:flex;flex-direction:column}.career a{display:flex;justify-content:space-between;border-top:1px solid var(--line);padding:.8rem;color:var(--fg);font-weight:650}.quality{background:#fff1e6;margin:0 calc(50% - 50vw);padding:6rem max(var(--pad),calc((100vw - 900px)/2 + var(--pad)));text-align:center}.quality blockquote{border:0;font-size:clamp(2rem,4vw,4rem);color:var(--fg)}.quality>p:not(.eyebrow){color:var(--fg-muted);max-width:65ch;margin:1rem auto}.ecosystem{display:flex;justify-content:center;align-items:center;gap:1rem;padding:5rem 0;font:500 .8rem var(--font-mono);flex-wrap:wrap}.ecosystem i{color:var(--accent)}.ecosystem small{width:100%;text-align:center;color:var(--fg-muted)}@media(max-width:800px){.outcomes{grid-template-columns:1fr 1fr}.assessment,.loop,.career{grid-template-columns:1fr}.courses__grid{grid-template-columns:1fr}.journey-grid,.specs>div{grid-template-columns:1fr}.section-block header{display:block}}@media(max-width:480px){.outcomes{grid-template-columns:1fr}.loop ol{grid-template-columns:1fr}}</style>
