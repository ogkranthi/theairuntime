---
import Base from "../layouts/Base.astro";
import { CHANNELS } from "../lib/course";
import { concepts, patterns } from "../data/knowledge";
const depths = [
  { time: "10 MIN", title: "Concepts", copy: "Build a precise mental model.", href: "/concepts/", mark: "01" },
  { time: "30 MIN", title: "Patterns", copy: "Make a production decision.", href: "/patterns/", mark: "02" },
  { time: "1 HOUR", title: "Systems", copy: "Trace a real architecture.", href: "/systems/", mark: "03" },
  { time: "15 HOURS", title: "Courses", copy: "Build connected expertise.", href: "/courses/", mark: "04" },
  { time: "HANDS-ON", title: "FDE Lab", copy: "Break it. Measure it. Prove it.", href: CHANNELS.lab, mark: "05", external: true },
];
---
<Base title="The Open Curriculum for Production AI Engineering | AIR Learn" description="Learn how reliable AI systems are designed, evaluated, deployed, and operated. Free, practical, and built from real production systems." pageSlug="home" jsonLd={[{"@context":"https://schema.org","@type":"WebSite",name:"The AI Runtime Learn",url:"https://learn.theairuntime.com/"}]}>
  <div class="shell">
    <section class="hero">
      <div class="hero__copy"><p class="eyebrow">THE AI RUNTIME / LEARN</p><h1>The Open Curriculum for <em>Production AI Engineering</em></h1><p class="hero__lede">Learn how AI systems are designed, evaluated, deployed, and operated when reliability matters.</p><div class="hero__actions"><a class="btn btn--solid" href="/courses/long-running-agents/">Start here <span aria-hidden="true">→</span></a><a class="btn" href="#curriculum">Explore the curriculum</a></div><p class="hero__meta">Free. Practical. Open. No signup required.</p></div>
      <aside class="hero__lens" aria-label="The FDE learning method"><p class="lens__label">LEARN LIKE AN FDE</p><ol><li><span>01</span>Start with the customer problem</li><li><span>02</span>Understand the architecture</li><li><span>03</span>Study what fails</li><li><span>04</span>Build it yourself</li></ol></aside>
    </section>

    <section class="section" id="curriculum"><div class="section-head"><div><p class="eyebrow">CHOOSE YOUR DEPTH</p><h2>One body of knowledge.<br/>Five ways in.</h2></div><p>You do not need a local environment to begin. Learn the idea in ten minutes, then go as deep as the problem demands.</p></div><div class="depth-grid">{depths.map((d) => <a class="depth" href={d.href} rel={d.external ? "noopener" : undefined}><span class="depth__mark">{d.mark}</span><span class="depth__time">{d.time}</span><h3>{d.title}</h3><p>{d.copy}</p><span class="depth__arrow">{d.external ? "↗" : "→"}</span></a>)}</div></section>

    <section class="section flagship"><div class="flagship__intro"><p class="eyebrow">START HERE · COURSE 001</p><h2>Engineering Long-Running AI Agents</h2><p>One coherent system, from a naive loop to a production runtime that survives failures, restarts, long waits, and changing context.</p><a class="btn btn--solid" href="/courses/long-running-agents/">Start Course 001 →</a></div><div class="flagship__map"><div class="numbers"><strong>16</strong><span>modules</span><strong>14</strong><span>failure labs</span><strong>5</strong><span>systems</span></div><pre aria-label="Course learning progression">{`UNDERSTAND\nmental models + architecture\n        ↓\nEXPLORE\ncode + traces + failures\n        ↓\nBUILD\nrepo + evals + deployment`}</pre></div></section>

    <section class="section knowledge"><div class="section-head"><div><p class="eyebrow">NEW IN THE KNOWLEDGE BASE</p><h2>Learn one thing.<br/>Use it today.</h2></div><p>Short, linkable explanations make the curriculum useful before—and long after—you finish the course.</p></div><div class="knowledge__columns"><div><p class="column-label">CONCEPTS · WHAT IT IS</p>{concepts.slice(0,5).map((item, i) => <a href={`/concepts/${item.slug}/`}><span>0{i+1}</span><strong>{item.title}</strong><small>{item.summary}</small><b>→</b></a>)}<a class="view-all" href="/concepts/">Explore all concepts →</a></div><div><p class="column-label">PATTERNS · WHEN TO USE IT</p>{patterns.slice(0,5).map((item, i) => <a href={`/patterns/${item.slug}/`}><span>0{i+1}</span><strong>{item.title}</strong><small>{item.summary}</small><b>→</b></a>)}<a class="view-all" href="/patterns/">Explore all patterns →</a></div></div></section>

    <section class="section skills"><div><p class="eyebrow">THE PRODUCTION AI SKILLS MAP</p><h2>Know what to learn next.</h2><p>See the complete terrain—from discovery and AI engineering to deployment and customer adoption—without turning it into a checklist of tools.</p><a class="btn" href="/skills/">Explore the skills map →</a></div><div class="skills__orbit" aria-label="Skills covered"><span>Discovery</span><span>AI Engineering</span><span>Software Engineering</span><span>Deployment</span><span>AI-Native Development</span><span>Customer Engineering</span></div></section>

    <section class="section proof"><p class="eyebrow">FROM KNOWLEDGE TO PROOF</p><div class="proof__flow"><span><b>01</b>Learn the concept</span><i>→</i><span><b>02</b>Study the system</span><i>→</i><span><b>03</b>Break it in the Lab</span><i>→</i><span><b>04</b>Publish the Field Report</span></div><p><a href={CHANNELS.lab} rel="noopener">Enter the FDE Lab ↗</a></p></section>
  </div>
</Base>

<style>
  .hero{min-height:calc(100vh - 3.5rem);display:grid;align-items:center;grid-template-columns:minmax(0,1.45fr) minmax(18rem,.55fr);gap:clamp(3rem,8vw,8rem);padding:6rem 0}.hero h1{font-size:clamp(3.2rem,7vw,6.6rem);line-height:.96;letter-spacing:-.06em;max-width:13ch;margin-bottom:1.75rem}.hero h1 em{font-style:normal;color:var(--accent)}.hero__lede{max-width:51ch;font-size:1.28rem;line-height:1.55;color:var(--fg-muted)}.hero__actions{display:flex;flex-wrap:wrap;gap:.75rem;margin:2rem 0 1.25rem}.hero__meta{font-family:var(--font-mono);font-size:.72rem;color:var(--fg-muted)}.hero__lens{border-left:1px solid var(--accent-dim);padding-left:1.5rem}.lens__label,.column-label{font-family:var(--font-mono);font-size:.68rem;letter-spacing:.12em;color:var(--accent)}.hero__lens ol{list-style:none;padding:0;margin:1.5rem 0 0}.hero__lens li{padding:.85rem 0;border-top:1px solid var(--line);font-size:.88rem}.hero__lens li span{display:inline-block;width:2.2rem;font-family:var(--font-mono);font-size:.68rem;color:var(--accent)}
  .section{padding:6rem 0}.section-head{display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:end;margin-bottom:2.5rem}.section-head h2{font-size:clamp(2.2rem,4.5vw,4rem)}.section-head>p{color:var(--fg-muted);max-width:46ch;justify-self:end}.depth-grid{display:grid;grid-template-columns:repeat(5,1fr);border:1px solid var(--line);background:var(--line);gap:1px}.depth{position:relative;background:var(--bg);color:var(--fg);padding:1.25rem;min-height:14rem;display:flex;flex-direction:column}.depth:hover{background:var(--bg-raise);text-decoration:none}.depth__mark{font-family:var(--font-mono);font-size:2rem;color:var(--accent-dim)}.depth__time{font-family:var(--font-mono);font-size:.65rem;color:var(--accent);margin-top:auto}.depth h3{margin:.4rem 0}.depth p{font-size:.78rem;color:var(--fg-muted);margin:0}.depth__arrow{position:absolute;right:1rem;top:1rem;color:var(--accent)}
  .flagship{display:grid;grid-template-columns:1.15fr .85fr;gap:5rem;background:var(--fg);color:var(--bg);margin-inline:calc(50% - 50vw);padding-inline:max(var(--pad),calc((100vw - var(--shell))/2 + var(--pad)))}.flagship h2{font-size:clamp(2.4rem,5vw,4.5rem);color:white;max-width:13ch}.flagship__intro>p:not(.eyebrow){color:#c4c4c8;max-width:52ch}.flagship__map{align-self:center}.numbers{display:grid;grid-template-columns:auto 1fr;gap:.2rem 1rem;align-items:baseline;margin-bottom:1.5rem}.numbers strong{font-size:2.5rem;color:#fff}.numbers span{font-family:var(--font-mono);font-size:.75rem;color:#a3a3ab}.flagship pre{border-color:#353539}
  .knowledge__columns{display:grid;grid-template-columns:1fr 1fr;gap:3rem}.knowledge__columns>div>a:not(.view-all){display:grid;grid-template-columns:2rem 1fr auto;column-gap:.75rem;padding:1rem 0;border-top:1px solid var(--line);color:var(--fg);align-items:start}.knowledge__columns a:hover{text-decoration:none}.knowledge__columns a span,.knowledge__columns a b{font-family:var(--font-mono);font-size:.7rem;color:var(--accent);font-weight:400}.knowledge__columns a small{grid-column:2;font-size:.75rem;color:var(--fg-muted)}.view-all{display:inline-block;margin-top:1.25rem;font-family:var(--font-mono);font-size:.75rem}
  .skills{display:grid;grid-template-columns:.8fr 1.2fr;gap:6rem;align-items:center}.skills h2{font-size:clamp(2.3rem,5vw,4rem)}.skills>div:first-child>p:not(.eyebrow){color:var(--fg-muted)}.skills__orbit{display:flex;flex-wrap:wrap;gap:.6rem;justify-content:center}.skills__orbit span{border:1px solid var(--line);border-radius:999px;padding:.8rem 1rem;font-family:var(--font-mono);font-size:.76rem;background:var(--bg-raise)}.skills__orbit span:nth-child(2){border-color:var(--accent);color:var(--accent);font-size:.9rem}
  .proof{text-align:center}.proof__flow{display:flex;justify-content:center;align-items:center;gap:1.2rem;margin:2.5rem 0;flex-wrap:wrap}.proof__flow span{font-weight:600}.proof__flow b{display:block;font-family:var(--font-mono);font-size:.65rem;color:var(--accent);margin-bottom:.25rem}.proof__flow i{font-style:normal;color:var(--accent-dim)}
  @media(max-width:900px){.hero{grid-template-columns:1fr;min-height:auto}.hero__lens{max-width:28rem}.depth-grid{grid-template-columns:repeat(2,1fr)}.depth:last-child{grid-column:1/-1}.flagship,.skills{grid-template-columns:1fr;gap:3rem}.section-head,.knowledge__columns{grid-template-columns:1fr}.section-head>p{justify-self:start}}
  @media(max-width:540px){.hero{padding:4rem 0}.hero h1{font-size:3rem}.section{padding:4rem 0}.depth-grid{grid-template-columns:1fr}.depth:last-child{grid-column:auto}.depth{min-height:11rem}.knowledge__columns{gap:3rem}.proof__flow{align-items:stretch;flex-direction:column}.proof__flow i{transform:rotate(90deg)}}
</style>
