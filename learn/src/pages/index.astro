---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import CtaBlock from "../components/CtaBlock.astro";
import CourseCard from "../components/CourseCard.astro";
import FdeLifecycle from "../components/FdeLifecycle.astro";
import { CHANNELS } from "../lib/course";

const courses = (await getCollection("courses")).sort((a, b) =>
  a.data.number.localeCompare(b.data.number),
);
const live = courses.filter((c) => c.data.status === "live");
const upcoming = courses.filter((c) => c.data.status !== "live");

const modes = [
  {
    badge: "PASSIVE FIRST",
    title: "Watch the Case Study",
    body: "Understand the customer problem, architecture, decisions and production lessons.",
  },
  {
    badge: "GO DEEPER",
    title: "Explore the System",
    body: "Inspect diagrams, code, traces, technology choices and deeper resources.",
  },
  {
    badge: "HANDS-ON",
    title: "Build It Yourself",
    body: "Clone the reference implementation and try optional labs.",
  },
];
---

<Base
  title="Learn AI Engineering Like an FDE | The AI Runtime"
  description="Real customer problems. Production architectures. Engineering decisions. Learn how AI systems are actually designed, built, deployed, and operated."
  pageSlug="home"
  jsonLd={[
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "The AI Runtime, FDE Engineering",
      url: "https://learn.theairuntime.com/",
    },
  ]}
>
  <div class="shell">
    <section class="hero section">
      <p class="eyebrow">THE AI RUNTIME · FDE ENGINEERING</p>
      <h1 class="hero__title">Learn AI Engineering Like an FDE</h1>
      <p class="hero__sub">
        Real customer problems. Production architectures. Engineering decisions. Learn how AI
        systems are actually designed, built, deployed, and operated.
      </p>
      <div class="hero__actions">
        <a class="btn btn--solid" href="/courses/">Explore courses</a>
        <a class="btn" href="/case-studies/">Browse case studies</a>
      </div>
      <p class="hero__meta">Free · Practical · Open-source implementations · No signup required</p>
    </section>

    <section class="section" id="how-you-learn">
      <h2>How you learn here</h2>
      <p class="muted measure">
        Every course is designed to be consumed passively first. Depth is there when you want
        it, never required to follow along.
      </p>
      <div class="modes">
        {
          modes.map((m, i) => (
            <article class="mode">
              <p class="mode__step" aria-hidden="true">{i + 1}</p>
              <p class="mode__badge">{m.badge}</p>
              <h3 class="mode__title">{m.title}</h3>
              <p class="mode__body">{m.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section" id="lifecycle">
      <h2>The FDE lifecycle</h2>
      <p class="muted measure">
        Forward-deployed engineering is a full loop, not a coding sprint. The curriculum
        teaches every stage of it, from the customer conversation to the 3am page.
      </p>
      <FdeLifecycle />
    </section>

    <section class="section" id="courses">
      <h2>Courses</h2>
      <div class="courses-grid courses-grid--live">
        {
          live.map((c) => (
            <CourseCard
              number={c.data.number}
              title={c.data.title}
              description={c.data.description}
              status={c.data.status}
              href={c.data.slug ? `/courses/${c.data.slug}/` : undefined}
              caseStudyTags={c.data.caseStudyTags}
              skills={c.data.skills}
              stats={c.data.stats}
            />
          ))
        }
      </div>
      <div class="courses-grid">
        {
          upcoming.map((c) => (
            <CourseCard
              number={c.data.number}
              title={c.data.title}
              description={c.data.description}
              status={c.data.status}
            />
          ))
        }
      </div>
      <p class="muted"><a href="/courses/">The full catalog &rarr;</a></p>
    </section>

    <section class="section" id="lab">
      <h2>Learn, explore, then do</h2>
      <div class="tri">
        <div>
          <p class="eyebrow eyebrow--muted">LEARN</p>
          <p class="muted">Understand how FDEs solve production AI problems, through courses built on real cases.</p>
        </div>
        <div>
          <p class="eyebrow eyebrow--muted">EXPLORE</p>
          <p class="muted">Study reference systems and <a href="/case-studies/">case studies</a>, with diagrams, decisions and code.</p>
        </div>
        <div>
          <p class="eyebrow eyebrow--muted">LAB</p>
          <p class="muted">Solve a client-shaped problem yourself at the <a href={CHANNELS.lab} rel="noopener">FDE Lab <span aria-hidden="true">&#8599;</span></a>.</p>
        </div>
      </div>
    </section>
  </div>

  <CtaBlock slot="footer-cta" pageSlug="home" />
</Base>

<style>
  .hero { padding-top: 4.5rem; }
  .hero__title {
    font-size: clamp(2.4rem, 6vw, 3.75rem);
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
    max-width: 18ch;
  }
  .hero__sub {
    font-size: 1.25rem;
    color: var(--fg-muted);
    margin: 0 0 2rem;
    max-width: 56ch;
  }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.5rem; }
  .hero__meta {
    font-family: var(--font-mono);
    font-size: var(--t-meta);
    color: var(--fg-muted);
    margin: 0;
  }

  .modes {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  .mode {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raise);
    padding: 1.5rem;
    position: relative;
  }
  .mode__step {
    font-family: var(--font-mono);
    font-size: 2rem;
    color: var(--accent-dim);
    margin: 0 0 0.5rem;
    line-height: 1;
  }
  .mode__badge {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    color: var(--accent);
    border: 1px solid var(--accent-dim);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    margin: 0;
  }
  .mode__title { font-size: var(--t-h3); margin: 0 0 0.4rem; }
  .mode__body { font-size: var(--t-meta); color: var(--fg-muted); margin: 0; max-width: 44ch; }

  .courses-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    margin: 1.5rem 0;
  }
  .tri {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }
  .tri p:last-child { margin-bottom: 0; font-size: var(--t-meta); }

  @media (min-width: 860px) {
    .modes { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .courses-grid:not(.courses-grid--live) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tri { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
