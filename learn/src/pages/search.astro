---
import Base from "../layouts/Base.astro"; import {concepts,patterns} from "../data/knowledge"; import {fdeSegments} from "../data/fde"; import {paths,specializations} from "../data/paths";
const items=[...concepts.map(x=>({...x,type:"Concept",href:`/learn/concepts/${x.slug}/`})),...patterns.map(x=>({...x,type:"Pattern",href:`/learn/patterns/${x.slug}/`})),...fdeSegments.map(x=>({title:x.title,summary:x.short,type:"Career segment",href:`/career/segments/${x.slug}/`})),...paths.map(x=>({title:x.title,summary:x.description,type:"Path",href:`/paths/${x.slug}/`})),...specializations.map(x=>({title:x.title,summary:x.summary,type:"Specialization",href:`/paths/specializations/${x.slug}/`}))];
---
<Base title="Search | FDE Commons" description="Search FDE Commons paths, concepts, patterns, specializations, and career segments." pageSlug="search"><div class="shell search"><header><p class="eyebrow">SEARCH THE COMMONS</p><h1>Find the mechanism, path, or role.</h1><label><span class="sr-only">Search</span><input type="search" placeholder="Try: durable execution, agent FDE, evidence…" autofocus data-query/></label><p><span data-count>{items.length}</span> curated resources · local, instant, no tracking</p></header><div class="results" data-results>{items.map(item=><a href={item.href} data-item={`${item.title} ${item.summary} ${item.type}`.toLowerCase()}><span>{item.type}</span><h2>{item.title}</h2><p>{item.summary}</p><b>→</b></a>)}</div></div><script>const input=document.querySelector<HTMLInputElement>("[data-query]");const nodes=[...document.querySelectorAll<HTMLElement>("[data-item]")];const count=document.querySelector("[data-count]");input?.addEventListener("input",()=>{const q=input.value.trim().toLowerCase();let n=0;nodes.forEach(el=>{const show=!q||el.dataset.item?.includes(q);el.hidden=!show;if(show)n++});if(count)count.textContent=String(n)})</script></Base>
<style>.search{max-width:950px}.search header{padding:6rem 0 3rem}.search h1{font-size:clamp(3rem,6vw,6rem)}.search input{width:100%;font:500 1.1rem var(--font-body);padding:1rem;border:2px solid var(--fg);background:white}.search header>p:last-child{font:400 .65rem var(--font-mono);color:var(--fg-muted);margin-top:1rem}.results{border-top:1px solid var(--line);padding-bottom:6rem}.results a{display:grid;grid-template-columns:8rem 1fr auto;gap:.5rem;padding:1rem;color:var(--fg);border-bottom:1px solid var(--line)}.results a:hover{text-decoration:none;background:#fff1e6}.results span{font:500 .62rem var(--font-mono);color:var(--accent)}.results h2{margin:0}.results p{grid-column:2;font-size:.75rem;color:var(--fg-muted)}.results b{grid-column:3;grid-row:1/3;color:var(--accent)}@media(max-width:600px){.results a{grid-template-columns:1fr auto}.results p{grid-column:1}.results b{grid-column:2}}</style>
