---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import CtaBlock from "../../components/CtaBlock.astro";
import { CHANNELS } from "../../lib/course";

const domains = await getCollection("skills");
const courses = await getCollection("courses");
const courseName = (id: string) => {
  const c = courses.find((x) => x.data.id === id);
  return c ? `Course ${c.data.number}` : id;
};
const courseHref = (id: string) => {
  const c = courses.find((x) => x.data.id === id);
  return c?.data.slug ? `/courses/${c.data.slug}/` : "/courses/";
};
---

<Base
  title="Skills Map | The AI Runtime, FDE Engineering"
  description="The skills of forward-deployed AI engineering, organized as a browsable taxonomy: discovery, AI engineering, software engineering, deployment, AI-native development, and customer engineering."
  pageSlug="skills"
>
  <div class="shell">
    <section class="section">
      <p class="eyebrow">SKILLS MAP</p>
      <h1>What an FDE actually knows</h1>
      <p class="muted measure">
        Six domains, from the customer conversation to the production pager. Skills link to
        the lessons, courses and case studies that teach them; unlinked skills mark where the
        catalog is still growing.
      </p>
    </section>

    {
      domains.map((dom) => (
        <section class="section">
          <h2>{dom.data.domain}</h2>
          <p class="muted measure">{dom.data.blurb}</p>
          <ul class="skilllist">
            {dom.data.skills.map((s) => (
              <li class="skill">
                <span class="skill__name">{s.name}</span>
                <span class="skill__links">
                  {s.lessons.map((href) => (
                    <a href={href}>lesson</a>
                  ))}
                  {s.courses.map((id) => (
                    <a href={courseHref(id)}>{courseName(id)}</a>
                  ))}
                  {s.caseStudies.map((slug) => (
                    <a href={`/case-studies/${slug}/`}>case study</a>
                  ))}
                  {s.labs.map((href) => (
                    <a href={href} rel="noopener">lab</a>
                  ))}
                  {s.external.map((e) => (
                    <a href={e.url} rel="noopener">{e.label} <span aria-hidden="true">&#8599;</span></a>
                  ))}
                  {s.lessons.length + s.courses.length + s.caseStudies.length + s.labs.length + s.external.length === 0 && (
                    <span class="skill__soon">coming to the catalog</span>
                  )}
                </span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <section class="section">
      <h2>Then go do it</h2>
      <p class="muted measure">
        Skills stick when they meet an unscripted problem. The
        <a href={CHANNELS.lab} rel="noopener">FDE Lab <span aria-hidden="true">&#8599;</span></a>
        runs client-shaped challenges with a reliability bar and public reports; it is where
        this map stops being a map.
      </p>
    </section>
  </div>

  <CtaBlock slot="footer-cta" pageSlug="skills" />
</Base>

<style>
  .skilllist { list-style: none; margin: 1rem 0 0; padding: 0; border-top: 1px solid var(--line); }
  .skill {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.25rem 2rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
    margin: 0;
    align-items: baseline;
  }
  .skill__name { font-weight: 600; color: var(--fg); }
  .skill__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
  .skill__soon { color: var(--fg-muted); font-family: var(--font-mono); font-size: 0.75rem; }
  @media (min-width: 760px) {
    .skill { grid-template-columns: 16rem minmax(0, 1fr); }
  }
</style>
