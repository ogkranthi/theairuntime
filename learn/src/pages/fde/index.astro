---
import Base from "../../layouts/Base.astro"; import FdeNav from "../../components/FdeNav.astro"; import {fdeSegments,roleFamily,companies} from "../../data/fde";
---
<Base title="FDE Career Atlas | The AI Runtime" description="A durable, evidence-backed map of Forward Deployed Engineering roles, segments, companies, and skills." pageSlug="fde-atlas">
<FdeNav/><div class="atlas">
  <section class="hero"><div><p class="eyebrow">THE AI RUNTIME / CAREER INTELLIGENCE</p><h1>Forward Deployed Engineering is a <em>role family.</em></h1><p class="lede">Understand what is being deployed, where the hard technical boundary sits, and which version of the job fits the engineer you want to become.</p><div class="actions"><a class="btn btn--solid" href="/fde/segments/">Explore 8 FDE segments</a><a class="btn" href="/fde/roles/">Decode a job description</a></div><p class="fresh">Research synthesis · August 15, 2026 · Primary sources linked</p></div><aside><span>THE CANONICAL QUESTION</span><h2>What exactly is being forward deployed?</h2><p>The title is weak evidence. The product, customer environment, and hard technical boundary reveal the actual job.</p><ol><li>Model capability</li><li>Agent workflow</li><li>Data platform</li><li>Inference stack</li><li>Mission or physical system</li></ol></aside></section>
  <section class="definition"><p>CANONICAL AIR DEFINITION</p><blockquote>A Forward Deployed Engineer is an engineer who owns technical outcomes close to the customer, building and adapting production systems in real operating environments while turning deployment learnings into reusable product or engineering improvements.</blockquote><div><article><span>01</span><h3>Engineer</h3><p>Can change the system—not only advise. The exact code surface varies; technical outcome ownership does not.</p></article><article><span>02</span><h3>Forward deployed</h3><p>Works near the production problem: customer cloud, engineering team, operations floor, government site, or physical field.</p></article><article><span>03</span><h3>Outcome owner</h3><p>Stays past the demo toward launch, reliability, adoption, measurable impact, and reusable product learning.</p></article></div></section>
  <section class="segments"><header><div><p class="eyebrow">THE MARKET MAP</p><h2>Eight roles hiding behind one title.</h2></div><a href="/fde/segments/">Compare all segments →</a></header><div class="grid">{fdeSegments.map(s=><a href={`/fde/segments/${s.slug}/`}><span>{s.number} / {s.accent}</span><h3>{s.title}</h3><p>{s.short}</p><b>{s.deployed} →</b></a>)}</div></section>
  <section class="axes"><div><p class="eyebrow">READ PAST THE TITLE</p><h2>Plot the role on three axes.</h2></div><ol><li><span>A</span><strong>Engineering depth</strong><small>Advisory ←→ direct software ownership</small></li><li><span>B</span><strong>Customer outcome ownership</strong><small>Enablement ←→ production impact</small></li><li><span>C</span><strong>Technical specialization</strong><small>Application · AI · data · infra · security · robotics</small></li></ol></section>
  <section class="bridge"><div><p class="eyebrow">FROM LEARNING TO WORK</p><h2>The missing bridge in production AI education.</h2></div><div class="flow"><span>AIR courses<small>production knowledge</small></span><i>↓</i><span>Concepts + systems<small>reusable mechanisms</small></span><i>↓</i><span class="hot">Career Atlas<small>how companies organize</small></span><i>↓</i><span>FDE Lab<small>proof you can do it</small></span></div></section>
  <section class="quick"><article><span>{roleFamily.length}</span><h3>Role variants decoded</h3><a href="/fde/roles/">Compare role boundaries →</a></article><article><span>{companies.length}</span><h3>Company operating models</h3><a href="/fde/companies/">Open the company map →</a></article><article><span>LIVE</span><h3>Time-sensitive openings</h3><a href="/fde/jobs/">Check official career pages →</a></article></section>
</div></Base>
<style>.atlas{max-width:1320px;margin:auto;padding:0 var(--pad)}.hero{min-height:42rem;display:grid;grid-template-columns:1.15fr .85fr;gap:7vw;align-items:center}.hero h1{font-size:clamp(3.4rem,7vw,7rem);line-height:.92;letter-spacing:-.065em;max-width:11ch}.hero h1 em{font-style:normal;color:var(--accent)}.lede{font-size:1.15rem;color:var(--fg-muted);max-width:56ch}.actions{display:flex;gap:.7rem;flex-wrap:wrap;margin:2rem 0}.fresh{font:400 .65rem var(--font-mono);color:var(--fg-muted)}.hero aside{background:#18181b;color:white;padding:2rem;border-top:5px solid #d55218}.hero aside>span,.definition>p{font:500 .65rem var(--font-mono);letter-spacing:.1em;color:#ed8a59}.hero aside h2{color:white;font-size:2.3rem}.hero aside p{color:#b8b8bf}.hero aside ol{columns:2;font:400 .75rem var(--font-mono)}.definition{background:#fff1e6;margin:0 calc(50% - 50vw);padding:6rem max(var(--pad),calc((100vw - 1320px)/2 + var(--pad)))}.definition blockquote{font-size:clamp(1.7rem,3.5vw,3.3rem);line-height:1.2;color:var(--fg);max-width:32ch;border:0;padding:0;margin:1.5rem 0 3rem}.definition>div{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #e5c5b1}.definition article{padding:1.2rem;border-right:1px solid #e5c5b1}.definition article span,.grid>a>span{font:500 .62rem var(--font-mono);color:var(--accent)}.definition article p{font-size:.8rem;color:var(--fg-muted)}.segments{padding:7rem 0}.segments header{display:flex;justify-content:space-between;align-items:end}.segments h2,.axes h2,.bridge h2{font-size:clamp(2.3rem,4vw,4rem)}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line);margin-top:2rem}.grid>a{background:white;color:var(--fg);padding:1.2rem;min-height:14rem;display:flex;flex-direction:column}.grid>a:hover{background:#fff8f3;text-decoration:none}.grid h3{margin-top:1.8rem}.grid p{font-size:.75rem;color:var(--fg-muted)}.grid b{margin-top:auto;font:500 .65rem var(--font-mono);color:var(--accent)}.axes{display:grid;grid-template-columns:.8fr 1.2fr;gap:6rem;padding:6rem 0;border-top:1px solid var(--line)}.axes ol{list-style:none;margin:0;padding:0}.axes li{display:grid;grid-template-columns:2rem 1fr;padding:1rem;border-bottom:1px solid var(--line)}.axes li>span{font:500 .7rem var(--font-mono);color:var(--accent)}.axes strong,.axes small{display:block}.axes small{grid-column:2;color:var(--fg-muted)}.bridge{display:grid;grid-template-columns:.8fr 1.2fr;gap:5rem;background:#18181b;color:white;margin:0 calc(50% - 50vw);padding:6rem max(var(--pad),calc((100vw - 1320px)/2 + var(--pad)))}.bridge h2{color:white}.flow{display:flex;flex-direction:column;align-items:stretch}.flow span{border:1px solid #38383e;padding:.8rem 1rem;font-weight:650}.flow span small{display:block;font:400 .62rem var(--font-mono);color:#96969e}.flow i{text-align:center;color:#d55218}.flow .hot{border-color:#d55218}.quick{display:grid;grid-template-columns:repeat(3,1fr);padding:6rem 0}.quick article{border-left:1px solid var(--line);padding:1.5rem}.quick article>span{font:500 2.4rem var(--font-mono);color:var(--accent)}.quick a{font:500 .68rem var(--font-mono)}@media(max-width:900px){.hero,.axes,.bridge{grid-template-columns:1fr}.hero{padding:5rem 0}.grid{grid-template-columns:1fr 1fr}.definition>div,.quick{grid-template-columns:1fr}.quick article{border-bottom:1px solid var(--line)}}@media(max-width:540px){.hero h1{font-size:3.5rem}.grid{grid-template-columns:1fr}.definition blockquote{font-size:1.7rem}}</style>
