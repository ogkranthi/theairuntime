import Base from "../../../layouts/Base.astro";
const primers=[
 {title:"APIs and HTTP for FDEs",enough:"You can trace a request, explain status codes, retries, timeouts, and idempotency.",url:"https://developer.mozilla.org/en-US/docs/Web/HTTP"},{title:"Database state and transactions",enough:"You can separate durable truth from process memory and reason about atomic changes.",url:"https://www.postgresql.org/docs/current/tutorial-transactions.html"},{title:"Queues and asynchronous work",enough:"You understand enqueue, claim, acknowledge, retry, and dead-letter behavior.",url:"https://aws.amazon.com/message-queue/"},{title:"Distributed failure basics",enough:"You assume messages can be late, duplicated, lost, or observed after ambiguous success.",url:"https://aws.amazon.com/builders-library/timeouts-retries-and-backoff-with-jitter/"},{title:"Identity and credentials",enough:"You can distinguish user identity, service identity, delegated authority, and secret storage.",url:"https://datatracker.ietf.org/doc/html/rfc6749"},{title:"Containers and deployment",enough:"You can package a service, pass configuration, inspect it, and replace it without trusting local state.",url:"https://docs.docker.com/get-started/"},{title:"Logs, metrics, and traces",enough:"You know which question each signal answers and how correlation IDs connect work.",url:"https://opentelemetry.io/docs/concepts/observability-primer/"},{title:"Latency versus throughput",enough:"You can explain queues, concurrency, percentiles, bottlenecks, and why averages mislead.",url:"https://sre.google/sre-book/monitoring-distributed-systems/"},{title:"GPU and inference basics",enough:"You can discuss memory, batching, utilization, latency, throughput, and serving cost.",url:"https://docs.nvidia.com/deeplearning/performance/"},{title:"Evaluation basics",enough:"You can define a dataset, rubric, metric, failure taxonomy, and trustworthy comparison.",url:"https://developers.google.com/machine-learning/crash-course/classification/accuracy-precision-recall"},{title:"Customer discovery basics",enough:"You can identify the user, job, constraints, evidence, authority, failure cost, and success measure.",url:"/practice/field-report/"}
];
---
<Base title="FDE Primers | FDE Commons" description="Focused prerequisite bridges for APIs, databases, queues, identity, deployment, observability, inference, evaluation, and discovery." pageSlug="primers"><div class="shell primers"><header><p class="eyebrow">PRIMERS</p><h1>Learn enough foundation to enter the real problem.</h1><p>These are bridges, not compressed computer-science degrees. Each primer defines the threshold you need, then points to an authoritative deep resource.</p></header><section>{primers.map((p,i)=><article><span>{String(i+1).padStart(2,"0")}</span><div><h2>{p.title}</h2><p><b>YOU NOW KNOW ENOUGH WHEN</b>{p.enough}</p></div><a href={p.url} rel={p.url.startsWith("http")?"noopener":undefined}>Authoritative resource {p.url.startsWith("http")?"↗":"→"}</a></article>)}</section></div></Base>
<style>.primers{max-width:1000px}.primers header{padding:7rem 0}.primers h1{font-size:clamp(3.5rem,7vw,7rem);max-width:14ch}.primers header>p:last-child{color:var(--fg-muted)}.primers section{padding-bottom:6rem}.primers article{display:grid;grid-template-columns:3rem 1fr 12rem;gap:1rem;padding:1.2rem;border-top:1px solid var(--line)}article>span,article p b{font:500 .62rem var(--font-mono);color:var(--accent)}article h2{margin:0}article p{font-size:.75rem;color:var(--fg-muted)}article p b{display:block}article>a{align-self:center;font:500 .65rem var(--font-mono)}@media(max-width:650px){.primers article{grid-template-columns:2rem 1fr}.primers article>a{grid-column:2}}</style>
