---
import Base from "../../../layouts/Base.astro";
import { concepts, patterns } from "../../../data/knowledge";
export function getStaticPaths() { return patterns.map((item) => ({ params: { slug: item.slug }, props: { item } })); }
const { item } = Astro.props;
---
<Base title={`${item.title} — AIR Pattern`} description={item.summary} pageSlug="patterns" ogType="article">
  <div class="shell pattern"><header class="section"><p class="eyebrow">AIR PATTERN · 30 MIN</p><h1>{item.title}</h1><p class="lede">{item.summary}</p><p class="module">USED IN · {item.module}</p></header>
  <article class="section prose"><h2>Problem</h2><p>An agent is operating across an unreliable boundary. Its local view may be stale, a previous attempt may have partially succeeded, and an apparently safe retry may create a second effect.</p><h2>Naive design</h2><pre><code>{`failure → retry the same action → hope`}</code></pre><h2>Pattern</h2><p>{item.summary} Make the precondition visible, keep evidence with the decision, and persist the outcome before allowing the workflow to advance.</p><pre><code>{`inspect current state\n        ↓\nvalidate invariant\n        ↓\nperform one bounded action\n        ↓\npersist outcome + evidence`}</code></pre><h2>Invariant</h2><blockquote>A run may advance only when the system can explain which state it observed, which decision it made, and which effect it accepted.</blockquote><h2>Tradeoffs</h2><p>This adds state, a verification step, and operational work. Use it where duplicated or untraceable effects cost more than the additional coordination.</p><h2>When not to use</h2><p>Skip this ceremony for disposable, read-only exploration where partial progress has no external consequence and a clean restart is genuinely safe.</p><h2>Concepts used</h2><div class="links">{item.related.map((slug) => { const concept = concepts.find((c) => c.slug === slug); return concept && <a href={`/learn/concepts/${slug}/`}>{concept.title} →</a>; })}</div><p class="course"><a href="/learn/courses/long-running-agents/">Learn it in context in Course 001 →</a></p></article></div>
</Base>
<style>.pattern{max-width:960px}.pattern h1{font-size:clamp(2.6rem,7vw,5rem)}.lede{font-size:1.3rem;max-width:55ch;color:var(--fg-muted)}.module{font-family:var(--font-mono);font-size:.75rem;color:var(--accent);margin-top:2rem}.prose{max-width:70ch}.prose h2{margin-top:2.5rem}.links{display:flex;flex-wrap:wrap;gap:.6rem}.links a{padding:.5rem .75rem;border:1px solid var(--line);border-radius:999px;font-family:var(--font-mono);font-size:.78rem}.course{margin-top:3rem;padding-top:1.5rem;border-top:1px solid var(--line)}</style>
