---
import Base from "../../../layouts/Base.astro";
import KnowledgeCard from "../../../components/KnowledgeCard.astro";
import { concepts } from "../../../data/knowledge";
---
<Base title="Production AI Concepts | The AI Runtime Learn" description="Short, canonical explanations of the concepts behind reliable production AI systems." pageSlug="concepts">
  <div class="shell">
    <header class="section intro">
      <p class="eyebrow">10 MINUTES · CANONICAL KNOWLEDGE</p>
      <h1>Concepts</h1>
      <p>Build the vocabulary of production AI engineering. Each concept starts with a plain definition, shows what breaks, and links back to the system where it matters.</p>
    </header>
    <section class="section">
      <div class="grid">{concepts.map((item) => <KnowledgeCard kind="concept" {...item} />)}</div>
    </section>
  </div>
</Base>
<style>.intro p:last-child{max-width:62ch;color:var(--fg-muted);font-size:1.2rem}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(15rem,1fr));gap:1rem}</style>
