---
import { getCollection } from "astro:content";
import Base from "../../../../layouts/Base.astro";
import CourseNav from "../../../../components/CourseNav.astro";
import CtaBlock from "../../../../components/CtaBlock.astro";
import ModuleCard from "../../../../components/ModuleCard.astro";
import CaseStudyCard from "../../../../components/CaseStudyCard.astro";
import TechnologyResource from "../../../../components/fde/TechnologyResource.astro";
import { CHANNELS, getModules, moduleHref, utm } from "../../../../lib/course";

const modules = await getModules();
const labCount = modules.filter((m) => m.data.lab).length;
const studies = await getCollection("caseStudies", ({ data }) =>
  data.courses.includes("course-001"),
);
const studyBydId = new Map(studies.map((s) => [s.id, s]));

const learningStages = [
  { step: "01", title: "See the problem", modules: "00–02", copy: "Start with a tiny agent loop. Learn why memory, process state, and model context are not durable state." },
  { step: "02", title: "Make it survive", modules: "03–07", copy: "Add checkpoints, safe side effects, worker ownership, recovery, and human approval—one failure at a time." },
  { step: "03", title: "Make it governable", modules: "08–12", copy: "Control context, observe behavior, enforce security boundaries, evaluate the path, and build the harness." },
  { step: "04", title: "Prove it", modules: "13–15", copy: "Compare real architectures, deploy the runtime, then run every failure together in the production gauntlet." },
];

const technologies = [
  { technology: "Python", why: "The whole reference implementation; modules 00-02 are plain Python so the loop is visible.", docsUrl: "https://docs.python.org/3/" },
  { technology: "LangGraph", why: "Graph execution, persistence, checkpoints and interrupts, adopted in Module 03 after the failures make them necessary.", primerUrl: "/learn/courses/long-running-agents/03-durable-execution/", docsUrl: "https://docs.langchain.com/oss/python/langgraph/overview" },
  { technology: "PostgreSQL", why: "Durable state, leases, event log, side-effect records. The load-bearing component.", docsUrl: "https://www.postgresql.org/docs/current/" },
  { technology: "Deep Agents", why: "The higher-level harness Module 12 ports to and interrogates.", docsUrl: "https://docs.langchain.com/oss/python/deepagents/overview" },
  { technology: "FastAPI + HTMX", why: "The run API, review endpoints and operator dashboard, with no frontend framework.", docsUrl: "https://fastapi.tiangolo.com/" },
  { technology: "Render + Neon", why: "The free-tier public deployment whose restarts double as failure injection.", docsUrl: "https://render.com/docs/free" },
];
---

<Base
  title="Engineering Long-Running AI Agents | AIR Course 001"
  description="Learn how to design agents whose work survives failures, restarts, long waits and changing context. 16 modules, 5 industry cases, 14 optional labs, one open reference implementation."
  pageSlug="long-running-agents"
  jsonLd={[
    {
      "@context": "https://schema.org",
      "@type": "Course",
      name: "Engineering Long-Running AI Agents",
      description:
        "Learn how to design agents whose work survives failures, restarts, long waits and changing context.",
      provider: { "@type": "Organization", name: "The AI Runtime", url: "https://theairuntime.com" },
      isAccessibleForFree: true,
      hasCourseInstance: { "@type": "CourseInstance", courseMode: "online", courseWorkload: "PT18H" },
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Courses", item: "https://learn.theairuntime.com/learn/courses/" },
        { "@type": "ListItem", position: 2, name: "Engineering Long-Running AI Agents" },
      ],
    },
  ]}
>
  <CourseNav active="overview" />
  <div class="shell">
    <section class="section chead">
      <p class="eyebrow">COURSE 001 · FDE ENGINEERING</p>
      <h1>Engineering Long-Running AI Agents</h1>
      <p class="chead__sub">
        Ship one customer-shaped AI workflow that is bounded, observable, recoverable,
        evidence-backed, cost-aware, and useful when the happy path ends.
      </p>
      <p class="chead__meta">
        {modules.length} modules · {studies.length} industry cases · {labCount} optional labs ·
        <a href={CHANNELS.repo} rel="noopener">reference repo <span aria-hidden="true">&#8599;</span></a>
      </p>
      <div class="chead__actions">
        <a class="btn btn--solid" href={moduleHref(modules[0]!)}>Start with Module 00</a>
        <a class="btn" href="/learn/courses/long-running-agents/capstone/">See what you will ship</a>
        <a class="btn" href={CHANNELS.repo} rel="noopener">View repo <span aria-hidden="true">&#8599;</span></a>
      </div>
      <p class="chead__fresh">Course content and API examples last verified: 2026-08 · exact dependency versions live in the reference repo lockfile</p>
      <p class="chead__continue" data-continue hidden>
        <a href="#" data-continue-link>Continue learning &rarr;</a>
      </p>
    </section>

    <section class="section outcome">
      <div><p class="eyebrow">THE PROMISE</p><h2>Not merely clever.<br/>Ready to be tested.</h2></div>
      <div class="outcome__body"><p>The course keeps its technical center: durable state, safe side effects, ownership, recovery, human control, context, observability, security, and evaluation. The FDE layer turns that runtime into one narrow workflow for a real user.</p><div class="outcome__qualities"><span>Bounded</span><span>Observable</span><span>Recoverable</span><span>Evidence-backed</span><span>Cost-aware</span><span>Useful</span></div><a href="/learn/courses/long-running-agents/capstone/">Open the customer-shaped capstone →</a></div>
    </section>

    <section class="section first-time" id="how-to-learn">
      <div class="first-time__intro">
        <p class="eyebrow">NEW TO PRODUCTION AI?</p>
        <h2>Watch or read first.<br/>Build only when ready.</h2>
        <p>You do not need the repository, Docker, an API key, or prior agent experience. Every module explains the failure visually before it introduces the engineering fix.</p>
      </div>
      <ol class="mode-grid">
        <li><span>1</span><div><strong>Understand</strong><small>Read or watch the explanation. No setup.</small></div></li>
        <li><span>2</span><div><strong>Trace</strong><small>Follow the code and failure timeline.</small></div></li>
        <li><span>3</span><div><strong>Check</strong><small>Answer one question in your own words.</small></div></li>
        <li><span>+</span><div><strong>Build · optional</strong><small>Run the lab only when you want practice.</small></div></li>
      </ol>
    </section>

    <section class="section" id="what-youll-learn">
      <p class="eyebrow">THE LEARNING PATH</p>
      <h2>One system. Four clear stages.</h2>
      <div class="stage-grid">
        {learningStages.map((stage) => <article><span>{stage.step}</span><small>MODULES {stage.modules}</small><h3>{stage.title}</h3><p>{stage.copy}</p></article>)}
      </div>
    </section>

    <section class="section" id="industry-cases">
      <h2>Industry cases</h2>
      <p class="muted measure">
        You build one canonical system, the Vendor Review Agent, all the way through. The
        concepts are grounded in five industry cases along the way: incident investigation,
        claims and document workflows, customer operations, enterprise data, and coding
        agents. One app to build, five systems to understand.
      </p>
      <div class="cases-grid">
        {
          studies.map((s) => (
            <CaseStudyCard
              href={`/learn/case-studies/${s.id}/`}
              title={s.data.title}
              category={s.data.category}
              summary={s.data.summary}
              concepts={s.data.concepts.slice(0, 3)}
            />
          ))
        }
      </div>
    </section>

    <section class="section" id="modules">
      <h2>Course modules</h2>
      <p class="muted measure">
        Each module answers one production question. Watch or read to follow the course
        completely; the labs and the repo are optional depth.
      </p>
      <div class="modlist">
        {
          modules.map((m) => {
            const cs = m.data.caseStudy ? studyBydId.get(m.data.caseStudy) : undefined;
            return (
              <ModuleCard
                entry={m}
                href={moduleHref(m)}
                caseTitle={cs?.data.title}
                caseHref={cs ? `/learn/case-studies/${cs.id}/` : undefined}
                repoBase={CHANNELS.repo}
              />
            );
          })
        }
      </div>
    </section>

    <section class="section" id="technologies">
      <h2>Technologies used</h2>
      <div class="tech-grid">
        {technologies.map((t) => <TechnologyResource {...t} />)}
      </div>
      <p class="muted"><a href="/learn/courses/long-running-agents/stack/">Why this stack, in depth &rarr;</a></p>
    </section>

    <section class="section" id="labs">
      <h2>Optional labs</h2>
      <p class="muted measure">
        {labCount} Failure Labs break the running system on purpose: kill the worker, duplicate
        the publish, poison a page, race two workers. Entirely optional; the lessons describe
        each failure well enough to learn from without running anything.
      </p>
      <p><a class="btn" href="/learn/courses/long-running-agents/labs/">Browse the labs</a></p>
    </section>

    <section class="section" id="reference">
      <h2>Reference implementation</h2>
      <p class="muted measure">
        The Vendor Review Agent lives in an open repo with the fixture server the labs run
        against. Clone it if you want your hands on the system; skip it if you are here to
        watch and read.
      </p>
      <p><a class="btn" href={CHANNELS.repo} rel="noopener">github.com/ogkranthi/air-course-long <span aria-hidden="true">&#8599;</span></a></p>
    </section>

    <section class="section" id="additional-resources">
      <h2>Additional resources</h2>
      <p class="muted measure">
        Every module links one to three primary sources with a sentence on why each is worth
        your time. The full annotated list lives on the
        <a href="/learn/courses/long-running-agents/sources/">course sources page</a>, and the
        site-wide library is at <a href="/resources/">/resources</a>.
      </p>
      <p class="muted measure">
        Local progress only: your Watched/Read marks and exit-criteria checklists live in this
        browser, never on a server.
        <button type="button" class="reset-btn" data-reset-progress>Reset local progress</button>
      </p>
    </section>
  </div>

  <CtaBlock slot="footer-cta" pageSlug="long-running-agents" />
</Base>

<script>
  // Continue learning: first module not yet marked read, from local progress.
  try {
    const done: string[] = JSON.parse(localStorage.getItem("air-c001-complete") ?? "[]");
    const marks = (slug: string) =>
      JSON.parse(localStorage.getItem(`air-c001-marks-${slug}`) ?? "{}");
    const rows = [...document.querySelectorAll<HTMLElement>("[data-module-slug]")];
    const next = rows.find((r) => {
      const slug = r.dataset.moduleSlug ?? "";
      return !done.includes(slug) && !marks(slug).read;
    });
    const started = rows.some((r) => {
      const slug = r.dataset.moduleSlug ?? "";
      return done.includes(slug) || marks(slug).read || marks(slug).watched;
    });
    const wrap = document.querySelector<HTMLElement>("[data-continue]");
    const link = document.querySelector<HTMLAnchorElement>("[data-continue-link]");
    if (wrap && link && started && next) {
      const a = next.querySelector<HTMLAnchorElement>("a[href]");
      if (a) {
        link.href = a.href;
        link.textContent = `Continue learning: ${a.textContent?.trim()} →`;
        wrap.hidden = false;
      }
    }
  } catch {
    /* storage unavailable: feature simply absent */
  }

  document.querySelector("[data-reset-progress]")?.addEventListener("click", () => {
    try {
      Object.keys(localStorage)
        .filter((k) => k.startsWith("air-c001-"))
        .forEach((k) => localStorage.removeItem(k));
      location.reload();
    } catch {
      /* nothing to reset */
    }
  });
</script>

<style>
  .chead h1 { font-size: clamp(2.2rem, 5vw, 3.25rem); max-width: 22ch; }
  .chead__sub { font-size: 1.2rem; color: var(--fg-muted); max-width: 52ch; margin: 0 0 1rem; }
  .chead__meta { font-family: var(--font-mono); font-size: var(--t-meta); color: var(--fg-muted); margin: 0 0 1.5rem; }
  .chead__actions { display: flex; flex-wrap: wrap; gap: 0.75rem 1.25rem; align-items: center; }
  .chead__soon { font-family: var(--font-mono); font-size: 0.75rem; color: var(--fg-muted); }
  .chead__continue { margin: 1.25rem 0 0; font-weight: 600; }
  .chead__fresh {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--fg-muted);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 0.4rem 0.7rem;
    max-width: fit-content;
    margin: 1.25rem 0 0;
  }
  .outcome { display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(2rem,7vw,7rem);background:#fff1e6;margin-inline:calc(50% - 50vw);padding-inline:max(var(--pad),calc((100vw - var(--shell))/2 + var(--pad))); }
  .outcome h2{font-size:clamp(2.2rem,4vw,3.8rem)}.outcome__body>p{color:var(--fg-muted);max-width:58ch}.outcome__qualities{display:flex;flex-wrap:wrap;gap:.45rem;margin:1.5rem 0}.outcome__qualities span{font:500 .68rem var(--font-mono);border:1px solid #e2b99d;background:#fffaf6;padding:.45rem .65rem;color:#9f3510}.outcome__body>a{font:600 .78rem var(--font-mono)}

  .first-time { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(2rem,6vw,6rem); align-items: center; }
  .first-time__intro h2 { font-size: clamp(2rem,4vw,3.6rem); }
  .first-time__intro>p:last-child { color: var(--fg-muted); max-width: 50ch; }
  .mode-grid { list-style: none; padding: 0; margin: 0; border: 1px solid var(--line); background: var(--bg-raise); }
  .mode-grid li { display: grid; grid-template-columns: 2rem 1fr; gap: .75rem; padding: .9rem 1rem; margin: 0; border-bottom: 1px solid var(--line); }
  .mode-grid li:last-child { border: 0; background: var(--bg-inset); }
  .mode-grid li>span { font: 500 .7rem var(--font-mono); color: var(--accent); }
  .mode-grid strong,.mode-grid small { display: block; }
  .mode-grid small { color: var(--fg-muted); font-size: .75rem; }
  .stage-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 1px; border: 1px solid var(--line); background: var(--line); margin-top: 1.5rem; }
  .stage-grid article { background: var(--bg-raise); padding: 1.25rem; min-height: 15rem; }
  .stage-grid article>span { display: block; font: 500 2rem var(--font-mono); color: var(--accent-dim); }
  .stage-grid article>small { font: 500 .62rem var(--font-mono); color: var(--accent); }
  .stage-grid h3 { margin-top: 2.5rem; }
  .stage-grid p { color: var(--fg-muted); font-size: .8rem; line-height: 1.5; }

  .cases-grid, .tech-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    margin: 1.5rem 0;
  }
  .modlist { display: grid; gap: 1rem; margin-top: 1.5rem; }
  .reset-btn {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-muted);
    background: none;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 0.25rem 0.6rem;
    cursor: pointer;
    margin-left: 0.5rem;
  }
  .reset-btn:hover { color: var(--accent); border-color: var(--accent-dim); }

  @media (min-width: 800px) {
    .cases-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tech-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 799px) {
    .first-time,.outcome { grid-template-columns: 1fr; }
    .stage-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 520px) { .stage-grid { grid-template-columns: 1fr; } }
  @media (min-width: 1100px) {
    .cases-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .tech-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
