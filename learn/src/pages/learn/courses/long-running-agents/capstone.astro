---
import Base from "../../../../layouts/Base.astro";
import CourseNav from "../../../../components/CourseNav.astro";
import { CHANNELS } from "../../../../lib/course";

const scorecard = [
  { key: "Bounded", question: "Can it stop before cost, time, or tool use escapes?", proof: "Budget envelope + termination tests" },
  { key: "Observable", question: "Can an operator explain its current state and history?", proof: "Run timeline + trace + operator view" },
  { key: "Recoverable", question: "Does useful work survive crashes, waits, and deploys?", proof: "Recovery tests + checkpoint evidence" },
  { key: "Evidence-backed", question: "Can a reviewer inspect the basis of every material claim?", proof: "Citations + durable artifacts" },
  { key: "Cost-aware", question: "Can you explain and constrain spend per successful outcome?", proof: "Cost ledger + budget degradation test" },
  { key: "Useful", question: "Does a real user complete the job better with the system?", proof: "User acceptance session + field notes" },
];

const weeks = [
  { n: "01", title: "Shape the job", output: "A one-page Field Brief", work: "Interview one user. Name the decision they need to make, the evidence they trust, the action the system may take, and the harm of being wrong." },
  { n: "02", title: "Define the contract", output: "Acceptance tests + invariants", work: "Turn the job into observable success criteria. Set budgets, human-control points, forbidden actions, and the six scorecard targets before adding tools." },
  { n: "03", title: "Ship the narrow path", output: "A deployed workflow", work: "Implement one useful end-to-end path. Keep authority in durable state, preserve evidence as artifacts, and expose the run to an operator." },
  { n: "04", title: "Break and measure", output: "A benchmark run", work: "Run the failure suite against a pinned fixture, model, prompt, and fault schedule. Record raw results rather than rewriting the story after the run." },
  { n: "05", title: "Return to the user", output: "A Field Report", work: "Put the system in front of the user. Record where they hesitated, overrode it, or still worked around it. Publish limitations and the next engineering decision." },
];
---

<Base title="Ship the Capstone | AIR Course 001" description="Turn the Course 001 runtime into a customer-shaped, deployed, measured, and publicly documented production AI workflow." pageSlug="course-capstone">
  <CourseNav active="capstone" />
  <div class="cap-shell">
    <section class="cap-hero">
      <div>
        <p class="eyebrow">COURSE 001 · SHIP IT</p>
        <h1>A runtime becomes useful only when a real user can trust the outcome.</h1>
        <p class="lede">Keep the technical spine. Add the FDE layer: shape one real job, deploy the narrowest useful workflow, break it deliberately, measure what remains true, and publish the evidence.</p>
        <div class="actions"><a class="btn btn--solid" href="#brief">Start the Field Brief</a><a class="btn" href={CHANNELS.repo} rel="noopener">Open the reference repo ↗</a></div>
      </div>
      <aside class="promise"><span>THE COURSE PROMISE</span><p>You will leave with an AI workflow that is not merely clever, but:</p><ul>{scorecard.map((item) => <li>{item.key}</li>)}</ul></aside>
    </section>

    <section class="score-section">
      <header><p class="eyebrow">THE PUBLIC BENCHMARK</p><h2>Six claims. Six forms of proof.</h2><span>Do not grade the demo. Grade the system under pressure.</span></header>
      <div class="scorecard">{scorecard.map((item, i) => <article><span>{String(i+1).padStart(2,"0")}</span><h3>{item.key}</h3><p>{item.question}</p><footer><b>PROVE WITH</b>{item.proof}</footer></article>)}</div>
    </section>

    <section class="build" id="brief">
      <header><p class="eyebrow">CUSTOMER-SHAPED CAPSTONE</p><h2>From a user problem to public evidence.</h2><p>Use the Vendor Review Agent if you need a complete example. Replace it only when you have access to a real user and a job with observable value.</p></header>
      <ol>{weeks.map((step) => <li><span>{step.n}</span><div><small>{step.output}</small><h3>{step.title}</h3><p>{step.work}</p></div></li>)}</ol>
    </section>

    <section class="brief-template">
      <div><p class="eyebrow">COPY THIS TEMPLATE</p><h2>The Field Brief</h2><p>Write this before architecture. If an answer is unknown, mark it unknown: do not replace discovery with an assumption.</p></div>
      <pre>{`USER
Who does this job today?

JOB
What decision or action must they complete?

EVIDENCE
What must the workflow inspect and preserve?

BOUNDARY
What may it do alone? What needs approval?

SUCCESS
What observable result is better than today?

FAILURE COST
What happens when it is slow, wrong, or unavailable?

BUDGET
Maximum time, cost, tool calls, and retries per run.`}</pre>
    </section>

    <section class="report">
      <div><p class="eyebrow">FINAL DELIVERABLE</p><h2>Publish a Field Report, not a victory lap.</h2></div>
      <div class="report-grid"><article><span>01</span><h3>Claim</h3><p>The narrow user outcome and the operating conditions you tested.</p></article><article><span>02</span><h3>Method</h3><p>Versions, fixtures, fault schedule, budgets, rubrics, and acceptance criteria.</p></article><article><span>03</span><h3>Evidence</h3><p>Scorecard, traces, event timelines, cost ledger, screenshots, and user notes.</p></article><article><span>04</span><h3>Failures</h3><p>What broke, why it broke, what changed, and which failures remain open.</p></article><article><span>05</span><h3>Limits</h3><p>What the result does not establish and where the workflow should not be used.</p></article><article><span>06</span><h3>Reproduce</h3><p>Repository, pinned configuration, commands, fixtures, and expected output.</p></article></div>
      <div class="final-actions"><a class="btn btn--solid" href="/learn/courses/long-running-agents/15-production-gauntlet/">Run the Production Gauntlet →</a><a class="btn" href="/learn/courses/long-running-agents/labs/">Browse all Failure Labs</a></div>
    </section>
  </div>
</Base>

<style>
  .cap-shell{--rust:#9f3510;--ember:#d55218;--sand:#fff1e6;--ink:#151519;max-width:1280px;margin:auto;padding:0 var(--pad)}
  .cap-hero{min-height:38rem;display:grid;grid-template-columns:1.2fr .8fr;gap:clamp(3rem,8vw,8rem);align-items:center;padding:6rem 0}.cap-hero h1{font-size:clamp(3rem,6vw,6rem);line-height:.96;letter-spacing:-.055em;max-width:13ch}.lede{font-size:1.15rem;color:var(--fg-muted);max-width:55ch}.actions,.final-actions{display:flex;gap:.7rem;flex-wrap:wrap;margin-top:2rem}.promise{background:var(--ink);color:white;padding:2rem;border-top:5px solid var(--ember)}.promise>span{font:500 .65rem var(--font-mono);letter-spacing:.12em;color:#ed8a59}.promise p{font-size:1.1rem;color:#c7c7cc}.promise ul{list-style:none;padding:0;margin:1.5rem 0 0;display:grid;grid-template-columns:1fr 1fr}.promise li{padding:.65rem 0;border-top:1px solid #37373c;color:white;font-weight:650}.promise li::before{content:'✓';color:#ed8a59;margin-right:.5rem}
  .score-section{background:var(--sand);margin:0 calc(50% - 50vw);padding:6rem max(var(--pad),calc((100vw - 1280px)/2 + var(--pad)))}.score-section>header,.build>header{display:grid;grid-template-columns:1fr 1fr;gap:2rem;align-items:end;margin-bottom:2rem}.score-section h2,.build h2,.report h2{font-size:clamp(2.3rem,4vw,4.2rem)}.score-section header>span,.build header>p{color:var(--fg-muted);max-width:42ch;justify-self:end}.scorecard{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#e6c7b4;border:1px solid #e6c7b4}.scorecard article{background:#fffaf6;padding:1.25rem;min-height:15rem;display:flex;flex-direction:column}.scorecard article>span,.report-grid span{font:500 .65rem var(--font-mono);color:var(--rust)}.scorecard h3{font-size:1.5rem;margin-top:1.5rem}.scorecard p{font-size:.82rem;color:var(--fg-muted)}.scorecard footer{margin-top:auto;border-top:1px solid #ead7ca;padding-top:.7rem;font:400 .7rem var(--font-mono)}.scorecard footer b{display:block;font-size:.58rem;color:var(--rust)}
  .build{padding:7rem 0}.build ol{list-style:none;padding:0;margin:0;border-top:1px solid var(--line)}.build li{display:grid;grid-template-columns:4rem 1fr;margin:0;padding:1.25rem 0;border-bottom:1px solid var(--line)}.build li>span{font:500 1.5rem var(--font-mono);color:var(--accent-dim)}.build li>div{display:grid;grid-template-columns:12rem 1fr 1.4fr;gap:1.5rem;align-items:start}.build li small{font:500 .65rem var(--font-mono);color:var(--rust);text-transform:uppercase}.build li h3{font-size:1.15rem}.build li p{font-size:.8rem;color:var(--fg-muted);margin:0}
  .brief-template{display:grid;grid-template-columns:.7fr 1.3fr;gap:4rem;background:var(--ink);color:white;margin:0 calc(50% - 50vw);padding:6rem max(var(--pad),calc((100vw - 1280px)/2 + var(--pad)))}.brief-template h2{color:white;font-size:3.5rem}.brief-template>div>p:last-child{color:#b8b8be}.brief-template pre{margin:0;border-color:#3c3c42;background:#1c1c21!important}.brief-template>*{min-width:0}
  .report{padding:7rem 0}.report>div:first-child{display:grid;grid-template-columns:.5fr 1.5fr;align-items:end}.report-grid{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line);margin:2rem 0}.report-grid article{padding:1.25rem;border-right:1px solid var(--line);border-bottom:1px solid var(--line);min-height:10rem}.report-grid article:nth-child(3n){border-right:0}.report-grid h3{margin-top:1rem}.report-grid p{font-size:.75rem;color:var(--fg-muted)}
  @media(max-width:850px){.cap-hero,.brief-template{grid-template-columns:1fr}.scorecard,.report-grid{grid-template-columns:1fr 1fr}.score-section>header,.build>header{grid-template-columns:1fr}.score-section header>span,.build header>p{justify-self:start}.build li>div{grid-template-columns:1fr}.report>div:first-child{grid-template-columns:1fr}}
  @media(max-width:540px){.cap-hero{padding:4rem 0}.cap-hero h1{font-size:3.2rem}.scorecard,.report-grid{grid-template-columns:1fr}.promise ul{grid-template-columns:1fr}.build li{grid-template-columns:2.5rem 1fr}.brief-template{gap:2rem}.report-grid article{border-right:0}}
</style>
