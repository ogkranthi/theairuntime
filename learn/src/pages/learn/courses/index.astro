---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import CtaBlock from "../../../components/CtaBlock.astro";
import CourseCard from "../../../components/CourseCard.astro";

const courses = (await getCollection("courses")).sort((a, b) =>
  a.data.number.localeCompare(b.data.number),
);
const live = courses.filter((course) => course.data.status === "live");
---

<Base
  title="Courses | The AI Runtime, FDE Engineering"
  description="AIR flagship courses teach production AI engineering through one coherent system, real failures, and reproducible labs."
  pageSlug="courses"
>
  <div class="shell">
    <section class="section">
      <p class="eyebrow">COURSES</p>
      <h1>Flagship courses</h1>
      <p class="muted measure">
        We publish one exceptional course before promising the next. Everything is free,
        readable end to end, and passive-first; repos and labs are optional depth, never a gate.
      </p>
    </section>

    <section class="section">
      <div class="grid">
        {
          live.map((c) => (
            <CourseCard
              number={c.data.number}
              title={c.data.title}
              description={c.data.description}
              status={c.data.status}
              href={c.data.slug ? `/learn/courses/${c.data.slug}/` : undefined}
              caseStudyTags={c.data.caseStudyTags}
              skills={c.data.skills}
              stats={c.data.stats}
            />
          ))
        }
      </div>
      <p class="muted">
        The next course will be shaped by what engineers hit after Course 001—not by a catalog
        deadline. Meanwhile, its reusable ideas are becoming <a href="/learn/concepts/">concepts</a>
        and <a href="/learn/patterns/">AIR Patterns</a>.
      </p>
    </section>
  </div>

  <CtaBlock slot="footer-cta" pageSlug="courses" />
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  .grid > :global(article:first-child) { grid-column: 1 / -1; }
  @media (min-width: 860px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
