---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import CtaBlock from "../../../components/CtaBlock.astro";
import CaseStudyCard from "../../../components/CaseStudyCard.astro";

const studies = await getCollection("caseStudies", ({ data }) => data.status !== "draft");
const categories = [
  "Financial Services",
  "Healthcare",
  "SaaS",
  "Developer Tools",
  "Enterprise Operations",
] as const;
const byCategory = categories
  .map((c) => ({ category: c, items: studies.filter((s) => s.data.category === c) }))
  .filter((g) => g.items.length > 0);
---

<Base
  title="Production AI Systems | The AI Runtime Learn"
  description="Architecture teardowns of production AI systems: the customer problem, the architecture, the decisions, and the lessons. Reusable across courses, browsable on their own."
  pageSlug="systems"
>
  <div class="shell">
    <section class="section">
      <p class="eyebrow">SYSTEMS · 1 HOUR</p>
      <h1>Systems, not demos</h1>
      <p class="muted measure">
        Each teardown is a production-shaped system: the customer problem it exists to
        solve, the architecture it committed to, the decisions along the way, and where the
        courses use it. Read them independently, or meet them inside a course.
      </p>
    </section>

    {
      byCategory.map((g) => (
        <section class="section">
          <h2>{g.category}</h2>
          <div class="grid">
            {g.items.map((s) => (
              <CaseStudyCard
                href={`/learn/systems/${s.id}/`}
                title={s.data.title}
                category={s.data.category}
                summary={s.data.summary}
                concepts={s.data.concepts}
              />
            ))}
          </div>
        </section>
      ))
    }
  </div>

  <CtaBlock slot="footer-cta" pageSlug="systems" />
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }
  @media (min-width: 860px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
