---
import LabLayout from '../layouts/LabLayout.astro';
import CTAButtons from '../components/lab/CTAButtons.astro';
import { REFERENCE_REPORT_URL } from '../lib/lab-links';

const steps = [
  'Brief and frozen rubric',
  'Build and score against public labels',
  'Publish a Field Report',
];
---
<LabLayout
  title="The AI Runtime Field Lab"
  description="Field challenges and reports for AI systems tested against real deployment constraints. Not demos. Field evidence."
  canonicalPath="/"
>
  <section class="hero">
    <div class="lab-container">
      <p class="mono-label eyebrow">The AI Runtime · Field Lab</p>
      <h1>Field challenges and reports for AI systems tested against real deployment constraints.</h1>
      <p class="core">Not demos. Field evidence.</p>
      <CTAButtons
        links={[
          { label: 'Start Field Challenge 01', href: '/01', primary: true },
          { label: 'Read the Reference Report', href: REFERENCE_REPORT_URL, external: true },
        ]}
      />
    </div>
  </section>

  <section class="sec">
    <div class="lab-container">
      <h2 class="mono-label">How it works</h2>
      <ol class="steps">
        {steps.map((s, i) => (
          <li>
            <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="step-text">{s}</span>
            {i < steps.length - 1 && <span class="step-arrow" aria-hidden="true">&rarr;</span>}
          </li>
        ))}
      </ol>
      <p class="how-note">
        Each Field Challenge ships with a customer-shaped brief, a frozen rubric, input records, a
        prediction schema, and a deterministic evaluator. Builders submit a Field Report, not just
        code.
      </p>
    </div>
  </section>

  <section class="sec">
    <div class="lab-container">
      <h2 class="mono-label">Current challenge</h2>
      <div class="challenge">
        <h3><a href="/01">Field Challenge 01: Financial Complaint Triage</a></h3>
        <p class="question">
          Can an AI agent route consumer finance complaints and flag regulatory risk without missing
          high-risk cases?
        </p>
        <dl class="facts">
          <div>
            <dt>Focus</dt>
            <dd>high-risk recall, routing accuracy, valid evidence rate</dd>
          </div>
          <div>
            <dt>Time</dt>
            <dd>30 to 60 minutes for a mini report, 2 to 4 hours for a full Field Report</dd>
          </div>
          <div>
            <dt>Note</dt>
            <dd>the evaluator runs against example predictions with no API key in under two minutes</dd>
          </div>
        </dl>
        <p class="challenge-cta"><a href="/01">View the challenge</a></p>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="lab-container">
      <div class="public-block">
        <p>
          <strong>Everything here is public.</strong> The dataset is derived from the CFPB Consumer
          Complaint Database, published by a US federal agency. Complaint narratives appear only when
          the consumer opts in, and the CFPB removes personal information before publication. The
          rubric, the 40 golden labels, the evaluator, and every Field Report are public. No
          confidential, customer, or proprietary information is used anywhere in the lab.
        </p>
      </div>
    </div>
  </section>

  <section class="sec unlock-sec">
    <div class="lab-container">
      <p class="mono-label unlock">Challenge 02 unlocks after five completed Field Reports on Challenge 01.</p>
    </div>
  </section>
</LabLayout>

<style>
  .hero { padding: 4rem 0 2.5rem; border-bottom: 1px solid var(--border); }
  .eyebrow { margin: 0 0 1rem; color: var(--accent); }
  .hero h1 { max-width: 26ch; font-size: clamp(1.6rem, 3.6vw, 2.3rem); }
  .core {
    margin: 1rem 0 1.75rem;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--text);
  }

  .sec { padding: 3rem 0; border-top: 1px solid var(--border); }
  .sec h2 { margin: 0 0 1.5rem; }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 1rem;
  }
  .steps li { display: flex; align-items: baseline; gap: 1rem; }
  .step-num { font-family: var(--font-mono); font-size: 0.78rem; color: var(--accent); }
  .step-text {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1.02rem;
    color: var(--text);
    letter-spacing: -0.01em;
  }
  .step-arrow { color: var(--text-3); font-size: 1.1rem; }
  .how-note { max-width: 44rem; margin: 1.5rem 0 0; color: var(--text-2); }

  .challenge {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-2);
    padding: 1.75rem 1.9rem;
  }
  .challenge h3 { margin: 0 0 0.4rem; font-size: 1.3rem; }
  .challenge h3 a { color: var(--text); text-decoration: none; }
  .challenge h3 a:hover { color: var(--accent); }
  .question { margin: 0 0 1.25rem; font-size: 1.05rem; color: var(--text-2); }
  .facts { margin: 0; display: grid; gap: 0.6rem; }
  .facts div { display: grid; grid-template-columns: 5.5rem 1fr; gap: 1rem; align-items: baseline; }
  .facts dt {
    font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--accent);
  }
  .facts dd { margin: 0; color: var(--text-2); font-size: 0.95rem; line-height: 1.6; }
  @media (max-width: 34rem) {
    .facts div { grid-template-columns: 1fr; gap: 0.15rem; }
  }
  .challenge-cta { margin: 1.25rem 0 0; font-size: 0.95rem; }
  .challenge-cta a { color: var(--accent); }

  .public-block {
    max-width: 46rem;
    border-left: 3px solid var(--accent);
    background: var(--bg-2);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    padding: 1.25rem 1.5rem;
  }
  .public-block p { margin: 0; color: var(--text-2); }
  .public-block strong { color: var(--text); }

  .unlock-sec { padding: 2rem 0 1rem; }
  .unlock { margin: 0; }
</style>
