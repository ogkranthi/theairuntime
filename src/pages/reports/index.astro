---
import { getCollection } from 'astro:content';
import LabLayout from '../../layouts/LabLayout.astro';
import ReportCard from '../../components/lab/ReportCard.astro';
import VerdictPill from '../../components/lab/VerdictPill.astro';
import { REFERENCE_REPORT_URL } from '../../lib/lab-links';

// Reference Report facts, kept in one place. Fill from the committed
// reports/000-reference.md in the challenge repo after each regeneration.
const reference = {
  title: 'Reference Report 001: Financial Complaint Triage',
  date: '', // e.g. "Jul 3, 2026"
  model: '', // the exact model string from the run
  recall: '', // high-risk recall, e.g. "0.75"
  accuracy: '', // routing accuracy, e.g. "0.72"
  evidence: '', // valid evidence rate, e.g. "0.82"
  failure: '', // the one-line most interesting failure
  url: REFERENCE_REPORT_URL,
};
const pending = 'in the report';

const all = await getCollection('reports');

// Builder field reports (no series, or series: "field").
const reports = all
  .filter((r) => r.data.series !== 'readiness')
  .sort((a, b) => {
    const da = a.data as any;
    const db = b.data as any;
    if (da.featured !== db.featured) return da.featured ? -1 : 1;
    return db.date.valueOf() - da.date.valueOf();
  });

// "Should Meridian Deploy It?" readiness reports, newest installment first.
const readiness = all
  .filter((r) => r.data.series === 'readiness')
  .sort((a, b) => (b.data as any).installment - (a.data as any).installment)
  .map((r) => {
    const d = r.data as any;
    return {
      slug: r.slug,
      installment: String(d.installment).padStart(2, '0'),
      title: String(d.title).replace(/:\s*Should Meridian Deploy It\?$/, ''),
      verdict: d.verdict,
    };
  });
---
<LabLayout
  title="Field Reports · The AI Runtime FDE Lab"
  description="Completed studies of AI systems tested against deployment constraints: results, honest failure tables, decision logs, and the lesson."
>
  <section class="hero">
    <div class="lab-container">
      <p class="mono-label eyebrow">FDE Lab · Reports</p>
      <h1>Field Reports</h1>
      <p class="sub">Completed studies of AI systems tested against deployment constraints.</p>
    </div>
  </section>

  <section class="sec">
    <div class="lab-container">
      <div class="col">
        <p>
          A Field Report documents a build against a frozen rubric: results, an honest failure table,
          a decision log, and the lesson. Reports are dated and versioned by model string. Featured
          community reports are added here and mentioned in The AI Runtime.
        </p>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="lab-container">
      <article class="ref">
        <p class="mono-label ref-eyebrow">Reference Report</p>
        <h2><a href={reference.url} target="_blank" rel="noopener">{reference.title}</a></h2>
        <dl class="facts">
          <div><dt>Date</dt><dd>{reference.date || pending}</dd></div>
          <div><dt>Model</dt><dd>{reference.model || pending}</dd></div>
          <div><dt>High-risk recall</dt><dd>{reference.recall || pending}</dd></div>
          <div><dt>Routing accuracy</dt><dd>{reference.accuracy || pending}</dd></div>
          <div><dt>Valid evidence rate</dt><dd>{reference.evidence || pending}</dd></div>
          <div><dt>Most interesting failure</dt><dd>{reference.failure || pending}</dd></div>
        </dl>
        <p class="ref-link"><a href={reference.url} target="_blank" rel="noopener">Read the Reference Report</a></p>
      </article>

      {reports.length > 0 && (
        <div class="grid">
          {reports.map((r) => {
            const d = r.data as any;
            return (
              <ReportCard
                slug={r.slug}
                title={d.title}
                builder_name={d.builder_name}
                builder_link={d.builder_link}
                lab_number={d.lab_number}
                summary={d.summary}
                result={d.result}
                repo_url={d.repo_url}
                writeup_url={d.writeup_url}
              />
            );
          })}
        </div>
      )}
    </div>
  </section>

  {readiness.length > 0 && (
    <section class="sec">
      <div class="lab-container">
        <h2 class="mono-label">Should Meridian Deploy It?</h2>
        <p class="col readiness-note">
          Readiness reports for AI systems, agent runtimes, and deployment surfaces assessed through
          an FDE lens.
        </p>
        <div class="readiness-list">
          {readiness.map((r) => (
            <a class="readiness-card" href={`/reports/${r.slug}`}>
              <span class="mono-label r-num">Installment {r.installment}</span>
              <span class="r-title">{r.title}</span>
              <span class="r-verdict"><span class="mono-label r-label">Verdict</span> <VerdictPill verdict={r.verdict} /></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</LabLayout>

<style>
  .hero { padding: 4rem 0 2.5rem; border-bottom: 1px solid var(--border); }
  .eyebrow { margin: 0 0 1rem; color: var(--accent); }
  .sub { max-width: 44rem; margin: 0.9rem 0 0; font-size: 1.15rem; color: var(--text-2); }
  .sec { padding: 2.5rem 0; border-top: 1px solid var(--border); }
  .col { max-width: 44rem; }
  .col p { margin: 0; color: var(--text-2); }

  .ref {
    max-width: 46rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-2);
    padding: 1.75rem 1.9rem;
  }
  .ref-eyebrow { margin: 0 0 0.6rem; color: var(--text-3); }
  .ref h2 { margin: 0 0 1.1rem; font-size: 1.25rem; }
  .ref h2 a { color: var(--text); text-decoration: none; }
  .ref h2 a:hover { color: var(--accent); }
  .facts { margin: 0; display: grid; gap: 0.55rem; }
  .facts div { display: grid; grid-template-columns: 12rem 1fr; gap: 1rem; align-items: baseline; }
  .facts dt {
    font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--accent);
  }
  .facts dd { margin: 0; color: var(--text-2); font-size: 0.95rem; line-height: 1.6; }
  @media (max-width: 34rem) {
    .facts div { grid-template-columns: 1fr; gap: 0.15rem; }
  }
  .ref-link { margin: 1.25rem 0 0; font-size: 0.95rem; }
  .ref-link a { color: var(--accent); }

  .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); margin-top: 1.5rem; }

  .readiness-note { margin: 0 0 1.5rem; color: var(--text-2); }
  .readiness-list { display: grid; gap: 1rem; max-width: 46rem; }
  .readiness-card {
    display: grid;
    gap: 0.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-2);
    padding: 1.4rem 1.6rem;
    text-decoration: none;
  }
  .readiness-card:hover { border-color: var(--accent); }
  .r-num { margin: 0; color: var(--text-3); }
  .r-title { font-size: 1.15rem; font-weight: 700; color: var(--text); }
  .readiness-card:hover .r-title { color: var(--accent); }
  .r-verdict { display: flex; align-items: center; gap: 0.6rem; margin-top: 0.25rem; }
  .r-label { margin: 0; color: var(--text-3); }
</style>
