---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import SubstackEmbed from '../components/SubstackEmbed.astro';
import RecapGallery from '../components/RecapGallery.astro';
import CredibilityStrip from '../components/CredibilityStrip.astro';
import StatBand from '../components/StatBand.astro';
import { getCollection } from 'astro:content';
import { fetchSubstackPosts } from '../lib/substack';
import { selfImprovingAi } from '../data/featured-reads';

const posts = await fetchSubstackPosts(4);
const dateFmt = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

// Most recent past Boston event that has photos, for the homepage energy band.
const bostonEvents = await getCollection('events', (e) => e.slug.startsWith('boston/'));
const lastRecap = bostonEvents
  .filter((e) => e.data.status === 'past' && e.data.recapPhotos.length > 0)
  .sort((a, b) => +b.data.date - +a.data.date)[0];
const lastRecapSlug = lastRecap?.slug.replace(/^boston\//, '');
---
<BaseLayout
  title="The AI Runtime"
  description="The AI Runtime is a community of AI practitioners. A weekly newsletter on production AI, monthly in-person meetups in Boston, and hands-on labs. Evals, agents, inference, reliability, cost."
>
  <section class="hero">
    <div class="container">
      <div class="grid">
        <div class="copy">
          <span class="tag">The AI Runtime</span>
          <h1>Production lessons from AI practitioners</h1>
          <p class="lede dim">
            The AI Runtime is a community of AI practitioners. Read the weekly newsletter, come to
            the Boston meetups, and listen to the <a href="https://theairuntime.com/s/fde-talks">FDE Talks podcast</a>. It starts
            with a free weekly issue of production lessons, the kind you'd forward to your team.
          </p>
          <div class="sub">
            <SubstackEmbed
              source="home-hero"
              variant="inline"
              buttonLabel="Subscribe free"
            />
          </div>
        </div>
        <div class="art">
          <a class="podcast-hero" href="https://theairuntime.com/s/fde-talks" aria-label="Listen to FDE Talks, the podcast by The AI Runtime">
            <img
              src="/fde-talks.jpg"
              alt="FDE Talks podcast cover: conversations from the field, by The AI Runtime"
              width="1200"
              height="1200"
            />
            <span class="podcast-cta">Listen to FDE Talks →</span>
          </a>
        </div>
        <a class="circle-hero" href="/fde-circle" aria-label="FDE Circle, an invite-only dinner for forward deployed engineers in Boston">
            <svg class="circle-mark" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
              <circle cx="32" cy="32" r="26" fill="none" stroke="currentColor" stroke-width="1" opacity="0.35" />
              <circle cx="58" cy="32" r="4.2" fill="currentColor" />
              <circle cx="50.4" cy="13.6" r="4.2" fill="currentColor" />
              <circle cx="32" cy="6" r="4.2" fill="currentColor" />
              <circle cx="13.6" cy="13.6" r="4.2" fill="currentColor" />
              <circle cx="6" cy="32" r="4.2" fill="currentColor" />
              <circle cx="13.6" cy="50.4" r="4.2" fill="currentColor" />
              <circle cx="32" cy="58" r="4.2" fill="currentColor" />
              <circle cx="50.4" cy="50.4" r="4.2" fill="currentColor" />
            </svg>
            <span class="circle-copy">
              <span class="circle-tag">Invite only</span>
              <span class="circle-name">FDE Circle</span>
              <span class="circle-line">A dinner for forward deployed engineers in Boston.</span>
            <span class="circle-cta">See the FDE Circle →</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <CredibilityStrip />

  <StatBand />

  <Section eyebrow="What we do" title="Read, meet, listen, and gather" flush>
    <ul class="arms">
      <li>
        <span class="arm-k">Read</span>
        <h3>The weekly newsletter</h3>
        <p class="dim">Production lessons on Vertical AI Agents, Model Reliability Engineering, and lessons from the trenches of shipping AI. Free, every week.</p>
        <a class="arm-link" href="https://theairuntime.com">Read the newsletter →</a>
      </li>
      <li>
        <span class="arm-k">Meet</span>
        <h3>The Boston meetup</h3>
        <p class="dim">A monthly meetup in Cambridge. Two practitioner talks a night, real production stories, and the people who ship.</p>
        <a class="arm-link" href="/boston">See the next event →</a>
      </li>
      <li>
        <span class="arm-k">Listen</span>
        <h3>FDE Talks</h3>
        <p class="dim">The AI Runtime podcast on forward deployed AI engineering: conversations with the people who take AI systems from demo to deployment.</p>
        <a class="arm-link" href="https://theairuntime.com/s/fde-talks">Listen to FDE Talks →</a>
      </li>
      <li>
        <span class="arm-k">Gather</span>
        <h3>FDE Circle</h3>
        <p class="dim">An invite-only dinner in Boston for forward deployed engineers. A small circle, off the record, the war stories that never make it into a talk.</p>
        <a class="arm-link" href="/fde-circle">See the FDE Circle →</a>
      </li>
    </ul>
  </Section>

  {posts.length > 0 && (
    <Section eyebrow="Latest issues" title="Fresh from the newsletter">
      <ul class="issues">
        {posts.map((p) => (
          <li>
            <a href={p.url} target="_blank" rel="noopener">
              <span class="date muted">{dateFmt.format(p.publishedAt)}</span>
              <span class="t">{p.title}</span>
              <span class="sum dim">{p.summary}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="more"><a href="https://theairuntime.com">Read every issue at theairuntime.com →</a></p>
    </Section>
  )}

  <Section eyebrow="In person" title="The AI Runtime Boston" narrow>
    <p class="dim">
      A monthly meetup in Cambridge for practitioners shipping AI to production. Two practitioner
      talks a night, real production stories.
    </p>
    <p>
      <a class="btn" href="/boston">See the next event →</a>
      <a class="btn btn-ghost" href="/speakers">Past speakers</a>
    </p>
  </Section>

  {lastRecap && (
    <Section eyebrow="In the room" title="From the last meetup">
      <p class="dim wide">
        A full room in Cambridge for {lastRecap.data.title}. Two production talks, real questions,
        people who ship. The next one is coming.
      </p>
      <RecapGallery photos={lastRecap.data.recapPhotos} />
      <p class="recap-links">
        <a class="btn btn-ghost" href={`/boston/${lastRecapSlug}#recap`}>See the full recap →</a>
        <a class="btn" href="/boston">Come to the next one</a>
      </p>
    </Section>
  )}

  <Section eyebrow="FDE Talks" title="The forward deployed engineering podcast" narrow>
    <p class="dim">
      FDE Talks is The AI Runtime podcast on forward deployed AI engineering: conversations with
      the people who take AI systems from demo to deployment.
    </p>
    <p>
      <a class="btn" href="https://theairuntime.com/s/fde-talks">Listen to FDE Talks →</a>
    </p>
  </Section>

  <Section eyebrow="Free resources" title="Free to read, no email required">
    <ul class="free-grid">
      <li>
        <span class="arm-k">Field Guide</span>
        <h3>The AI Runtime Field Guide</h3>
        <p class="dim">
          A guided reading path through The AI Runtime for AI practitioners. The essential reads on AI
          engineering, Model Reliability Engineering, and vertical agents, in the order that builds real
          production intuition.
        </p>
        <p class="free-cta">
          <a class="btn" href="/resources/the-ai-runtime-field-guide.pdf" download>Download the PDF →</a>
          <a class="btn btn-ghost" href="/library">Reading library</a>
        </p>
      </li>
      <li>
        <span class="arm-k">Essay</span>
        <h3>{selfImprovingAi.title}</h3>
        <p class="dim">{selfImprovingAi.description}</p>
        <p class="free-cta">
          <a class="btn" href={selfImprovingAi.url} target="_blank" rel="noopener">Read the article →</a>
        </p>
      </li>
    </ul>
  </Section>

  <Section eyebrow="Subscribe" title="Get it in your inbox" narrow>
    <p class="dim">
      Free, weekly, anti-hype. Production lessons from practitioners, plus the next Boston event
      before the public drop.
    </p>
    <SubstackEmbed
      source="home-footer"
      headline="Get The AI Runtime in your inbox"
      subhead="One free issue a week. The operational layer where AI actually runs."
      buttonLabel="Subscribe free"
      bullets={[
        'Evals, agents, inference, reliability, cost',
        'Specific and sourced, the kind of piece you forward to your team',
        'The next Boston meetup before the public Luma drop',
      ]}
    />
  </Section>
</BaseLayout>

<style>
  .wide { max-width: 42rem; }
  .recap-links { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1.5rem; }

  /* Two free reads side by side: the Field Guide PDF and the latest free essay. */
  .free-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  @media (max-width: 760px) { .free-grid { grid-template-columns: 1fr; } }
  .free-grid li {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 140ms ease;
  }
  .free-grid li:hover { border-color: var(--accent); }
  .free-grid h3 { margin: 0.5rem 0 0.5rem; font-size: 1.15rem; }
  .free-grid p.dim { font-size: 0.95rem; }
  .free-cta { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: auto; padding-top: 1rem; }
  .arms {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  @media (max-width: 1040px) { .arms { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 760px) { .arms { grid-template-columns: 1fr; } }
  .arms li {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 140ms ease;
  }
  .arms li:hover { border-color: var(--accent); }
  .arm-k {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 700;
  }
  .arms h3 { margin: 0.5rem 0 0.5rem; font-size: 1.15rem; }
  .arms p { font-size: 0.95rem; }
  .arm-link {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .hero {
    padding: 4.5rem 0 4rem;
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(ellipse at top right, rgba(251, 146, 60, 0.10), transparent 55%),
      var(--bg);
  }
  .grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    grid-template-areas:
      'copy art'
      'copy circle';
    gap: 1rem 2.5rem;
    align-items: center;
  }
  .copy { grid-area: copy; }
  .art { grid-area: art; justify-self: center; }
  .circle-hero { grid-area: circle; justify-self: center; }
  @media (max-width: 720px) {
    /* Keep the podcast cover above the headline, but push the second tile
       below the copy so the h1 is not driven off the first screen. */
    .grid { display: flex; flex-direction: column; }
    .art { order: -1; }
    .copy { order: 0; }
    .circle-hero { order: 1; align-self: center; }
  }
  h1 { margin: 0.7rem 0 0; }
  .lede { font-size: 1.15rem; max-width: 36rem; margin-top: 1rem; }
  .sub { margin-top: 1.75rem; max-width: 32rem; }
  .art { display: flex; justify-content: center; }
  .podcast-hero {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    max-width: 21rem;
    text-decoration: none;
  }
  .podcast-hero img {
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    display: block;
  }
  .podcast-hero:hover img { border-color: var(--accent); }
  .podcast-cta {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--accent);
    text-align: center;
  }

  /* Companion tile to the podcast cover: FDE Circle has no cover art, so the
     mark is drawn, eight seats around one ring. */
  .circle-hero {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
    max-width: 21rem;
    padding: 1.1rem 1.2rem;
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 140ms ease;
  }
  .circle-hero:hover { border-color: var(--accent); }
  .circle-mark { width: 46px; height: 46px; flex: 0 0 auto; color: var(--accent); }
  .circle-copy { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
  .circle-tag {
    font-family: var(--font-mono);
    font-size: 0.63rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .circle-name { font-weight: 700; font-size: 1.02rem; color: var(--text); }
  .circle-line { font-size: 0.83rem; line-height: 1.45; color: var(--text-2); }
  .circle-cta {
    margin-top: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent);
  }

  .issues { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .issues a {
    display: grid;
    grid-template-columns: 110px 1fr;
    grid-template-areas: 'date title' 'date sum';
    gap: 0.1rem 1.25rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text);
    text-decoration: none;
  }
  .issues a:hover { border-color: var(--accent); }
  .issues .date { grid-area: date; font-family: var(--font-mono); font-size: 0.8rem; padding-top: 0.15rem; }
  .issues .t { grid-area: title; font-family: var(--font-mono); font-weight: 700; }
  .issues .sum { grid-area: sum; font-size: 0.92rem; }
  @media (max-width: 560px) {
    .issues a { grid-template-columns: 1fr; grid-template-areas: 'date' 'title' 'sum'; gap: 0.25rem; }
  }
  .more { margin-top: 1.25rem; font-family: var(--font-mono); font-size: 0.9rem; }
</style>
